#\ code: var spd = String(_getVal('speed') || '').trim(); if (spd) lines.push('    speed = ' + spd);
#\ code: var mdl = String(_getVal('model') || '').trim(); if (mdl) lines.push('    model = "' + q(mdl) + '"');
#\ code: var tex = String(_getVal('texture') || '').trim(); if (tex) lines.push('    texture = "' + q(tex) + '"');
#\ code: var anim = String(_getVal('animation') || '').trim(); if (anim) lines.push('    animation = "' + q(anim) + '"');
#\ code: var idle = String(_getVal('idleAnim') || '').trim(); if (idle) lines.push('    idleAnim = "' + q(idle) + '"');
#\ code: var walk = String(_getVal('walkAnim') || '').trim(); if (walk) lines.push('    walkAnim = "' + q(walk) + '"');
