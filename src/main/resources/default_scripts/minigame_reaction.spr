# Reaction Test Minigame
val spawn = findSafeBlock("player", 5, 3)
if (spawn == null) {
    chat("§c[Reaction] Не нашёл безопасное место рядом с игроком!")
} else {
    val sx = listGet(spawn, 0)
    val sy = listGet(spawn, 1)
    val sz = listGet(spawn, 2)

    create npc reaction_master {
        name = "§cМастер Реакций"
        pos = sx, sy, sz
        showName = true
        model = "geo/defolt.geo.json"
        texture = "textures/entity/defolt.png"
        animation = "animations/npc_classic.animation.json"
    }

    chat("§a[Reaction] Мастер реакций появился рядом с тобой! Нажми ПКМ.")

    on interact(reaction_master) -> start_reaction {
        async {
            val p = _eventPlayer
            reaction_master.alwaysLookAt(p)
            reaction_master.playOnce("hello")
            
            var best = p.savedData.get("reaction_best")
            var best_text = "Нет"
            if (best != null) {
                best_text = (best * 0.1) + " сек"
            }
            
            say(reaction_master, "Твой рекорд: " + best_text + ". Проверим! Как только кнопка станет ЗЕЛЁНОЙ — жми!")

            create ui reaction_ui {
                size = ["200", "120"]
                background = "#DD222222"
                canClose = false
                
                text("txt_record", "Рекорд: " + best_text) {
                    pos = ["50", "10"]
                    color = "#AAAAAA"
                }

                button("btn_wait", "Жди...") {
                    pos = ["50", "40"]
                    size = ["100", "40"]
                    color = "#AA2222"
                    hover = "#AA2222"
                }
            }

            uiOpen(p, reaction_ui)

            val wait_time = random(2, 6)
            var clicked_early = false

            async "reaction_wait" {
                val click = await uiClick(p)
                if (click == "btn_wait") {
                    clicked_early = true
                }
            }

            await time(wait_time)

            if (clicked_early) {
                uiClose(p)
                reaction_master.playOnce("sad")
                say(reaction_master, "Слишком рано! Ты проиграл.")
                playSound(p, "minecraft:block.note_block.bass", 1.0, 0.5)
                return null
            }

            stopTask("reaction_wait")

            uiUpdate(p, "btn_wait", "color", "#22AA22")
            uiUpdate(p, "btn_wait", "hover", "#44FF44")
            uiUpdate(p, "btn_wait", "label", "ЖМИ!")
            uiUpdate(p, "btn_wait", "id", "btn_go")

            var time_taken = 0
            var clicked = false

            async "reaction_timer" {
                while (!clicked) {
                    await time(0.1)
                    time_taken = time_taken + 1
                }
            }

            val btn = await uiClick(p)
            clicked = true
            uiClose(p)

            if (btn == "btn_go") {
                val time_sec = time_taken * 0.1
                var new_record = false
                
                if (best == null || time_taken < best) {
                    p.savedData.set("reaction_best", time_taken)
                    new_record = true
                }
                
                if (time_taken < 5) {
                    reaction_master.playOnce("happy")
                    say(reaction_master, "Молниеносная реакция! " + time_sec + " сек!")
                    playSound(p, "minecraft:entity.player.levelup", 1.0, 2.0)
                } else if (time_taken < 10) {
                    reaction_master.playOnce("yes")
                    say(reaction_master, "Неплохо! " + time_sec + " сек!")
                    playSound(p, "minecraft:entity.experience_orb.pickup", 1.0, 1.0)
                } else {
                    reaction_master.playOnce("sad")
                    say(reaction_master, "Медленновато... " + time_sec + " сек.")
                    playSound(p, "minecraft:block.note_block.bass", 1.0, 0.5)
                }
                
                if (new_record) {
                    reaction_master.playOnce("laughter")
                    say(reaction_master, "§eНовый рекорд!")
                    spawnOrb("minecraft:textures/item/diamond.png", 5, reaction_master.x, reaction_master.y + 1, reaction_master.z)
                    await orbPickup(p, 5, "minecraft:textures/item/diamond.png")
                    giveItem(p, "minecraft:diamond", 1)
                }
            }
        }
    }
}
