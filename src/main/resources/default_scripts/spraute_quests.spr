# ================================================================
#  Spraute Quests — Журнал квестов
#  Запуск: /spraute run spraute_quests
#  import("spraute_quests") — API в других скриптах
#  Открытие/закрытие: клавиша H
# ================================================================

# ──── Заготовленные статусы квеста (можно и через функции questStatus*()) ────
val QS_AVAILABLE = "§aДоступен"
val QS_PROGRESS = "§eВ процессе"
val QS_COMPLETED = "§2Выполнен"
val QS_FAILED = "§cПровален"
val QS_FROZEN = "§bЗаморожен"
val QS_HIDDEN = "§8Скрыт"

# Состояния отдельных целей: active | done | failed

# ──── Список квестов мира (сохраняется между сессиями) ────
if (!hasVar("quest_list")) {
    var world quest_list = listCreate()

    val q1 = dictCreate()
    dictSet(q1, "id", "iron_forge")
    dictSet(q1, "name", "Железный заказ")
    dictSet(q1, "author", "Кузнец Борис")
    dictSet(q1, "status", QS_PROGRESS)
    dictSet(q1, "goal_list", list(
        dict("text", "Принести 30 слитков железа", "state", "active"),
        dict("text", "Отдать кузнецу Борису", "state", "active")
    ))
    dictSet(q1, "goals", "")
    dictSet(q1, "desc", "Кузнец Борис из деревни у реки попросил тебя раздобыть 30 железных слитков.\nБез них он не сможет выковать новый меч для капитана стражи.\nЗагляни в шахты к югу от деревни — там всегда было полно руды.")
    listAdd(quest_list, q1)

    val q2 = dictCreate()
    dictSet(q2, "id", "lost_crystal")
    dictSet(q2, "name", "Потерянный артефакт")
    dictSet(q2, "author", "Маг Элара")
    dictSet(q2, "status", QS_AVAILABLE)
    dictSet(q2, "goal_list", list(
        dict("text", "Найти Кристалл Бури в подземелье", "state", "active"),
        dict("text", "Вернуть кристалл магу Эларе", "state", "active")
    ))
    dictSet(q2, "goals", "")
    dictSet(q2, "desc", "Маг Элара из башни на холме потеряла древний Кристалл Бури, который унесли скелеты в подземелье под руинами.\nБез этого кристалла она не может защитить деревню от надвигающегося шторма.")
    listAdd(quest_list, q2)

    val q3 = dictCreate()
    dictSet(q3, "id", "oak_spirit")
    dictSet(q3, "name", "Страж леса")
    dictSet(q3, "author", "Дух Дуба")
    dictSet(q3, "status", QS_COMPLETED)
    dictSet(q3, "goal_list", list(
        dict("text", "Посадить 10 саженцев дуба", "state", "done"),
        dict("text", "Поговорить с Духом Дуба", "state", "done")
    ))
    dictSet(q3, "goals", "")
    dictSet(q3, "desc", "Древний Дух Дуба попросил восстановить вырубленный участок леса.\nТы посадил саженцы и лес начал возрождаться.\nДух благословил тебя силой природы.")
    listAdd(quest_list, q3)
}

# ──── Статусы (алиасы) ────
fun questStatusAvailable() { return QS_AVAILABLE }
fun questStatusInProgress() { return QS_PROGRESS }
fun questStatusCompleted() { return QS_COMPLETED }
fun questStatusFailed() { return QS_FAILED }
fun questStatusFrozen() { return QS_FROZEN }
fun questStatusHidden() { return QS_HIDDEN }

fun set_quest_available(id) { set_quest_status(id, QS_AVAILABLE) }
fun set_quest_in_progress(id) { set_quest_status(id, QS_PROGRESS) }
fun set_quest_completed(id) { set_quest_status(id, QS_COMPLETED) }
fun set_quest_failed(id) { set_quest_status(id, QS_FAILED) }
fun set_quest_frozen(id) { set_quest_status(id, QS_FROZEN) }
fun set_quest_hidden(id) { set_quest_status(id, QS_HIDDEN) }

# ──── Внутренние хелперы ────
fun find_quest(id) {
    val count = listSize(quest_list)
    var i = 0
    while (i < count) {
        val q = listGet(quest_list, i)
        if (dictGet(q, "id") == id) { return q }
        i = i + 1
    }
    return null
}

fun quest_goal(text) {
    return dict("text", text, "state", "active")
}

fun quest_import_goals_text(q, raw) {
    if (raw == null) { return }
    if (raw == "") { return }
    val gl = dictGet(q, "goal_list")
    val lines = raw.split("\n")
    var i = 0
    while (i < listSize(lines)) {
        var line = listGet(lines, i)
        line = line.replace("• ", "")
        line = line.replace("•", "")
        if (line != "") {
            listAdd(gl, quest_goal(line))
        }
        i = i + 1
    }
}

fun quest_get_goal_list(q) {
    var gl = dictGet(q, "goal_list")
    if (gl == null) {
        gl = list()
        dictSet(q, "goal_list", gl)
        val legacy = dictGet(q, "goals")
        if (legacy != null) {
            if (legacy != "") {
                quest_import_goals_text(q, legacy)
            }
        }
    }
    return gl
}

fun quest_format_goals_display(q) {
    val gl = quest_get_goal_list(q)
    var out = ""
    var i = 0
    while (i < listSize(gl)) {
        val g = listGet(gl, i)
        val txt = dictGet(g, "text")
        val st = dictGet(g, "state")
        var line = ""
        if (st == "done") {
            line = "§a§m✔ " + txt + "§r"
        } else if (st == "failed") {
            line = "§c✖ " + txt
        } else {
            line = "§7• " + txt
        }
        if (out == "") { out = line }
        else { out = out + "\n" + line }
        i = i + 1
    }
    dictSet(q, "goals", out)
    return out
}

fun quest_maybe_auto_complete(id) {
    val q = find_quest(id)
    if (q == null) { return }
    val gl = quest_get_goal_list(q)
    if (listSize(gl) < 1) { return }
    var all_done = true
    var i = 0
    while (i < listSize(gl)) {
        val g = listGet(gl, i)
        if (dictGet(g, "state") != "done") { all_done = false }
        i = i + 1
    }
    if (all_done) {
        set_quest_completed(id)
    }
}

fun quest_set_goal_state(id, index, state) {
    val q = find_quest(id)
    if (q == null) { return }
    val gl = quest_get_goal_list(q)
    if (index < 0) { return }
    if (index >= listSize(gl)) { return }
    val g = listGet(gl, index)
    dictSet(g, "state", state)
    quest_format_goals_display(q)
    if (state == "done") {
        set_quest_in_progress(id)
        quest_maybe_auto_complete(id)
    }
}

fun quest_set_goal_state_by_text(id, needle, state) {
    val q = find_quest(id)
    if (q == null) { return }
    if (needle == null) { return }
    if (needle == "") { return }
    val gl = quest_get_goal_list(q)
    var i = 0
    while (i < listSize(gl)) {
        val g = listGet(gl, i)
        val txt = dictGet(g, "text")
        if (txt.contains(needle)) {
            dictSet(g, "state", state)
        }
        i = i + 1
    }
    quest_format_goals_display(q)
    if (state == "done") {
        set_quest_in_progress(id)
        quest_maybe_auto_complete(id)
    }
}

# ──── API: квесты ────
fun add_quest(id, name, author, desc, goals) {
    val q = dictCreate()
    dictSet(q, "id", id)
    dictSet(q, "name", name)
    dictSet(q, "author", author)
    dictSet(q, "status", QS_AVAILABLE)
    dictSet(q, "goal_list", list())
    dictSet(q, "goals", "")
    dictSet(q, "desc", desc)
    if (goals != null) {
        if (goals != "") {
            quest_import_goals_text(q, goals)
        }
    }
    quest_format_goals_display(q)
    listAdd(quest_list, q)
}

fun add_quest_with_goals(id, name, author, desc, goal_list) {
    val q = dictCreate()
    dictSet(q, "id", id)
    dictSet(q, "name", name)
    dictSet(q, "author", author)
    dictSet(q, "status", QS_AVAILABLE)
    dictSet(q, "goal_list", goal_list)
    dictSet(q, "goals", "")
    dictSet(q, "desc", desc)
    quest_format_goals_display(q)
    listAdd(quest_list, q)
}

fun has_quest(id) {
    if (find_quest(id) != null) { return true }
    return false
}

fun set_quest_field(id, field, value) {
    val q = find_quest(id)
    if (q == null) { return }
    dictSet(q, field, value)
}

fun set_quest_status(id, status) {
    set_quest_field(id, "status", status)
}

fun remove_quest(id) {
    val count = listSize(quest_list)
    var i = 0
    var to_remove = -1
    while (i < count) {
        val q = listGet(quest_list, i)
        if (dictGet(q, "id") == id) {
            to_remove = i
        }
        i = i + 1
    }
    if (to_remove >= 0) {
        listRemove(quest_list, to_remove)
    }
}

# ──── API: цели (index с 0) ────
fun add_quest_goal(id, goal) {
    val q = find_quest(id)
    if (q == null) { return }
    val gl = quest_get_goal_list(q)
    listAdd(gl, quest_goal(goal))
    quest_format_goals_display(q)
}

fun complete_quest_goal(id, index) {
    quest_set_goal_state(id, index, "done")
}

fun fail_quest_goal(id, index) {
    quest_set_goal_state(id, index, "failed")
}

fun reset_quest_goal(id, index) {
    quest_set_goal_state(id, index, "active")
}

fun complete_quest_goal_by_text(id, needle) {
    quest_set_goal_state_by_text(id, needle, "done")
}

fun fail_quest_goal_by_text(id, needle) {
    quest_set_goal_state_by_text(id, needle, "failed")
}

# ──── API: описание ────
fun add_quest_desc(id, text) {
    append_quest_desc(id, text)
}

fun append_quest_desc(id, text) {
    val q = find_quest(id)
    if (q == null) { return }
    if (text == null) { return }
    if (text == "") { return }
    var old_desc = dictGet(q, "desc")
    if (old_desc == null) { old_desc = "" }
    if (old_desc == "") {
        dictSet(q, "desc", text)
    } else {
        dictSet(q, "desc", old_desc + "\n" + text)
    }
}

# ================================================================
#  UI: Полноэкранный журнал квестов
# ================================================================

val player = getNearestPlayer()
var selected_idx = 0

fun quest_row_h(quest_name) {
    var nl = strNewlineCount(quest_name) + 1
    val wrap_lines = (strLen(quest_name) + 34) / 35
    if (wrap_lines > nl) {
        nl = wrap_lines
    }
    return 4 + nl * 5 + 6
}

fun open_quest_ui(p, sel) {
    val count = listSize(quest_list)
    var safe_sel = sel
    if (count > 0) {
        if (safe_sel < 0) { safe_sel = 0 }
        if (safe_sel >= count) { safe_sel = count - 1 }
    }
    selected_idx = safe_sel

    var sidebar_h = 12
    var j = 0
    while (j < count) {
        val qj = listGet(quest_list, j)
        sidebar_h = sidebar_h + quest_row_h(dictGet(qj, "name")) + 2
        j = j + 1
    }

    create ui quest_menu {
        size = ["100%", "100%"]
        background = "#B2000000"
        canClose = true

        rect("sidebar_bg") {
            pos = [0, 0]
            size = ["25.71%", "100%"]
            color = "#B21E1E28"
            layer = 0
        }

        divider("sidebar_div") {
            pos = ["25.71%", 0]
            size = [1, "100%"]
            color = "#B2FFFFFF"
            layer = 0
        }

        scroll("quest_scroll") {
            pos = [4, 8]
            size = ["25%", "96%"]
            content_h = sidebar_h
            scrollbar = true
            color = "#30000000"
            layer = 2

            var y_acc = 6
            var i = 0
            while (i < count) {
                val q = listGet(quest_list, i)
                val q_name = dictGet(q, "name")
                val q_author = dictGet(q, "author")
                val row_h = quest_row_h(q_name)

                var btn_color = "#40335577"
                if (i == safe_sel) {
                    btn_color = "#80556699"
                }

                button("sel_" + i, q_name) {
                    pos = [0, y_acc]
                    size = ["98%", row_h]
                    color = btn_color
                    hover = "#8066AACC"
                    label_wrap = 300
                    label_scale = 0.68
                    sub_label = "§7" + q_author
                    sub_scale = 0.52
                }

                y_acc = y_acc + row_h + 2
                i = i + 1
            }
        }

        if (count > 0) {
            rect("right_bg") {
                pos = ["27%", 0]
                size = ["73%", "100%"]
                color = "#B2121218"
                layer = 1
            }

            val sel_q = listGet(quest_list, safe_sel)
            val s_name = dictGet(sel_q, "name")
            val s_author = dictGet(sel_q, "author")
            val s_status = dictGet(sel_q, "status")
            val s_goals = quest_format_goals_display(sel_q)
            val s_desc = dictGet(sel_q, "desc")

            val gl = strLen(s_goals)
            val dl = strLen(s_desc)
            var goals_lines = strNewlineCount(s_goals) + 1
            val goals_wrap = (gl + 71) / 72
            if (goals_wrap > goals_lines) {
                goals_lines = goals_wrap
            }
            if (goals_lines < 1) {
                goals_lines = 1
            }
            val goals_h = goals_lines * 9
            val y_div_desc = 68 + goals_h + 2
            val y_desc_t = y_div_desc + 4
            val y_desc_b = y_desc_t + 9
            var desc_lines = strNewlineCount(s_desc) + 1
            val desc_wrap = (dl + 71) / 72
            if (desc_wrap > desc_lines) {
                desc_lines = desc_wrap
            }
            if (desc_lines < 1) {
                desc_lines = 1
            }
            val detail_content_h = y_desc_b + desc_lines * 9 + 12

            scroll("detail_scroll") {
                pos = ["28%", 6]
                size = ["72%", "94%"]
                content_h = detail_content_h
                auto_scrollbar = true
                scrollbar = false
                color = "#30000000"
                layer = 2

                text("d_name", "§l" + s_name) {
                    pos = [6, 4]
                    color = "#FFFFFF"
                    scale = 1.3
                }

                text("d_author", "§7Квестодатель: §f" + s_author) {
                    pos = [6, 22]
                    color = "#AAAAAA"
                    scale = 0.85
                }

                text("d_status", "§7Статус: " + s_status) {
                    pos = [6, 34]
                    color = "#AAAAAA"
                    scale = 0.85
                }

                divider("div_goals") {
                    pos = [6, 48]
                    size = ["96%", 1]
                    color = "#33FFFFFF"
                }

                text("d_goals_t", "§e§lЦели:") {
                    pos = [6, 54]
                    color = "#FFAA00"
                    scale = 0.95
                }

                text("d_goals", s_goals) {
                    pos = [6, 68]
                    color = "#DDDDDD"
                    scale = 0.85
                    wrap = "96%"
                    align = "left"
                }

                divider("div_desc") {
                    pos = [6, y_div_desc]
                    size = ["96%", 1]
                    color = "#33FFFFFF"
                }

                text("d_desc_t", "§b§lОписание:") {
                    pos = [6, y_desc_t]
                    color = "#55BBFF"
                    scale = 0.95
                }

                text("d_desc", s_desc) {
                    pos = [6, y_desc_b]
                    color = "#CCCCCC"
                    scale = 0.8
                    wrap = "96%"
                    align = "left"
                }
            }
        } else {
            text("empty_msg", "Нет активных квестов") {
                pos = ["28%", "42%"]
                color = "#FFCCCCCC"
                scale = 1.0
                layer = 2
            }
        }
    }

    uiOpen(p, quest_menu)
}

var global quest_journal_open = false
var global quest_journal_player = null

on uiClick() -> quests_ui_click {
    if (!quest_journal_open) { return null }
    val p = _eventPlayer
    val click = _eventWidget
    if (p == null) { return null }
    var idx = 0
    val cnt = listSize(quest_list)
    while (idx < cnt) {
        if (click == "sel_" + idx) {
            selected_idx = idx
            open_quest_ui(p, selected_idx)
        }
        idx = idx + 1
    }
}

on uiClose() -> quests_ui_close {
    if (quest_journal_open) {
        quest_journal_open = false
        quest_journal_player = null
    }
}

on keybind("h") -> toggle_quests {
    val p = _eventPlayer

    if (quest_journal_open) {
        uiClose(p)
        quest_journal_open = false
        quest_journal_player = null
    } else {
        quest_journal_open = true
        quest_journal_player = p
        selected_idx = 0
        open_quest_ui(p, selected_idx)
    }
}
