# Библиотека кастомного чата
# import("spraute_chat")
#
# Имя и цвет берутся из настроек движка (формат с $Name, цвет #RRGGBB):
#   formatChatName(name)  — подставить имя в формат
#   getChatNameColor()    — цвет имени
#   getChatNameFormat()   — шаблон формата
# Пустой/null color в npcChat/playerChat тоже берёт цвет из настроек.
#
# npcChat(viewer, speaker, text, color, seconds, headScale, anchorYVal)
# playerChat(viewer, text, color, seconds)
# customChatEx(viewer, message, who, whoRef, seconds, headScale, anchorYVal)
#
# CHAT_HEAD_SCALE  — базовый масштаб головы NPC
# CHAT_HEAD_ANCHOR_Y — вертикаль головы (anchor_y), 0 = верх, 1 = низ. Меньше = выше.
#   Для одного сообщения: 7-й арг npcChat(..., anchorYVal).

global val chat_history = list()
global val chat_msg_counter = 0

global val CHAT_HEAD_SCALE = 3.8
global val CHAT_HEAD_ANCHOR_Y = 0.67
global val CHAT_HOLD_SEC = 5

# Layout constants — shared by live bar and history (1:1).
global val CHAT_HEAD_W = 28
global val CHAT_PAD_RIGHT = 8
global val CHAT_PAD_TOP = 4
global val CHAT_PAD_BOTTOM = 4
global val CHAT_NAME_H = 12
global val CHAT_LINE_H = 10
global val CHAT_MIN_W = 100
global val CHAT_MAX_W = 320
global val CHAT_MIN_H = 34
global val CHAT_BG = "#CC111111"
global val CHAT_TEXT = "#FFFFFF"

fun chatLog(tag, msg) {
    log("[spraute_chat/" + tag + "] " + msg)
}

fun chatLogV(viewer, tag, msg) {
    var vname = "?"
    if (viewer != null) {
        vname = viewer.name
        if (vname == null) { vname = "?" }
    }
    log("[spraute_chat/" + tag + " v=" + vname + "] " + msg)
}

fun chat_hold_seconds(seconds) {
    if (seconds == null)  { return CHAT_HOLD_SEC }
    if (seconds <= 0)     { return CHAT_HOLD_SEC }
    return seconds
}

fun chat_head_scale(headScale) {
    if (headScale == null) { return CHAT_HEAD_SCALE }
    return headScale
}

fun chat_head_anchor_y(anchorYVal) {
    if (anchorYVal == null) { return CHAT_HEAD_ANCHOR_Y }
    return anchorYVal
}

fun chat_history_clear() {
    while (chat_history.size() > 0) {
        chat_history.remove(0)
    }
    chatLog("clear", "history cleared")
}

fun calc_wrapped_lines(text, wrap_w) {
    var text_w = strWidth(text)
    if (text_w <= wrap_w) { return 1 }
    return (text_w // wrap_w) + 1
}

# Same metrics as the live chat bar — used by chatShow and history.
fun chat_msg_layout(displayName, text) {
    val shown = formatChatName(displayName)
    val name_w = strWidth(shown)
    val full_text_w = strWidth(text) + 6
    var bar_w = CHAT_HEAD_W + full_text_w + CHAT_PAD_RIGHT
    if (bar_w < CHAT_HEAD_W + name_w + CHAT_PAD_RIGHT) { bar_w = CHAT_HEAD_W + name_w + CHAT_PAD_RIGHT }
    if (bar_w < CHAT_MIN_W) { bar_w = CHAT_MIN_W }
    if (bar_w > CHAT_MAX_W) { bar_w = CHAT_MAX_W }

    val wrap_w = bar_w - CHAT_HEAD_W - CHAT_PAD_RIGHT
    val lines = calc_wrapped_lines(text, wrap_w)
    var bar_h = CHAT_PAD_TOP + CHAT_NAME_H + (lines * CHAT_LINE_H) + CHAT_PAD_BOTTOM
    if (bar_h < CHAT_MIN_H) { bar_h = CHAT_MIN_H }

    return dict(
        "bar_w", bar_w,
        "bar_h", bar_h,
        "wrap_w", wrap_w,
        "head_w", CHAT_HEAD_W,
        "pad_top", CHAT_PAD_TOP,
        "pad_bottom", CHAT_PAD_BOTTOM,
        "name_h", CHAT_NAME_H
    )
}

fun chat_entity_ref(npcRef) {
    if (npcRef == null) { return "avatar" }
    var ent = npcRef
    if (npcRef.entity != null) { ent = npcRef.entity }
    val uid = ent.uuid
    if (uid != null) {
        if (uid != "") { return uid }
    }
    if (npcRef.id != null) {
        if (npcRef.id != "") { return "npc:" + npcRef.id }
    }
    return "npc:" + npcRef
}

fun chat_resolve_color(color) {
    if (color == null) { return getChatNameColor() }
    if (color == "") { return getChatNameColor() }
    return color
}

fun npcChat(viewer, speaker, text, color, seconds, headScale, anchorYVal) {
    var ent = speaker
    if (speaker != null) {
        if (speaker.entity != null) { ent = speaker.entity }
    }
    var speakerName = speaker.name
    if (speakerName == null || speakerName == "") {
        if (ent != null) { speakerName = ent.name }
    }
    if (speakerName == null || speakerName == "") { speakerName = "Неизвестный" }
    chatLogV(viewer, "npcChat", "speaker=" + speakerName + " sec=" + seconds + " scale=" + headScale + " ay=" + anchorYVal)
    chatShow(viewer, ent, text, color, null, speakerName, "npc", seconds, headScale, anchorYVal)
}

fun playerChat(viewer, text, color, seconds) {
    var speakerName = viewer.name
    if (speakerName == null || speakerName == "") { speakerName = "Игрок" }
    chatLogV(viewer, "playerChat", "sec=" + seconds)
    chatShow(viewer, viewer, text, color, viewer, speakerName, "player", seconds, null, null)
}

fun customChatEx(viewer, message, who, whoRef, seconds, headScale, anchorYVal) {
    var skinPlayer = null
    var npcRef = whoRef
    var displayName = ""
    var nameColor = getChatNameColor()
    if (who == "player") {
        skinPlayer = whoRef
        displayName = whoRef.name
        if (displayName == null || displayName == "") { displayName = "Игрок" }
    } else {
        if (whoRef != null) {
            if (whoRef.entity != null) { npcRef = whoRef.entity }
        }
        displayName = whoRef.name
        if (displayName == null || displayName == "") {
            if (npcRef != null) { displayName = npcRef.name }
        }
        if (displayName == null || displayName == "") { displayName = "Неизвестный" }
    }
    chatLogV(viewer, "customChatEx", "who=" + who + " name=" + displayName)
    chatShow(viewer, npcRef, message, nameColor, skinPlayer, displayName, who, seconds, headScale, anchorYVal)
}

fun chatShow(viewer, npcRef, text, color, skinPlayer, displayName, who, seconds, headScale, anchorYVal) {
    stopTask("chat_fade")

    val shown = formatChatName(displayName)
    val nameCol = chat_resolve_color(color)

    chat_history.add(dict(
        "name", displayName,
        "text", text,
        "color", nameCol,
        "npc", npcRef,
        "skinPlayer", skinPlayer,
        "who", who,
        "headScale", headScale,
        "anchorYVal", anchorYVal
    ))
    if (chat_history.size() > 50) { chat_history.remove(0) }

    chat_msg_counter = chat_msg_counter + 1
    val my_counter = chat_msg_counter
    val chat_fade_sec = chat_hold_seconds(seconds)
    val head_scale = chat_head_scale(headScale)
    val head_anchor_y = chat_head_anchor_y(anchorYVal)

    chatLogV(viewer, "chatShow", "counter=" + my_counter + " hold=" + chat_fade_sec + " scale=" + head_scale + " ay=" + head_anchor_y)

    val lay = chat_msg_layout(displayName, text)
    val bar_w = lay["bar_w"]
    val bar_h = lay["bar_h"]
    val wrap_w = lay["wrap_w"]
    val head_w = lay["head_w"]
    val pad_top = lay["pad_top"]
    val name_h = lay["name_h"]
    val ent_ref = chat_entity_ref(npcRef)

    if (who == "player") {
        val skin_tex = getPlayerSkinTexture(skinPlayer)
        val head_sz = 16
        val hat_sz = 18
        val head_x = 6
        val head_y = (bar_h - head_sz) // 2
        val hat_x = 5
        val hat_y = head_y - 1

        create ui chat_bar {
            id = "spraute_chat_bar"
            size = [bar_w, bar_h]
            pos = ["center", -40]
            background = "#00000000"

            clip("chat_clip") {
                pos = [0, 0]
                size = [bar_w, bar_h]
                alpha = 1.0

                rect("chat_bg") {
                    pos = [0, 0]
                    size = [bar_w, bar_h]
                    color = CHAT_BG
                }
                image("chat_head", skin_tex + "/head") {
                    pos = [head_x, head_y]
                    size = [head_sz, head_sz]
                }
                image("chat_head_hat", skin_tex + "/hat") {
                    pos = [hat_x, hat_y]
                    size = [hat_sz, hat_sz]
                    layer = 1
                }
                text("chat_name", shown) {
                    pos = [head_w, pad_top]
                    color = nameCol
                    scale = 1.0
                }
                text("textText", text) {
                    pos = [head_w, pad_top + name_h]
                    color = CHAT_TEXT
                    wrap = wrap_w
                }
            }
        }
    } else {
        create ui chat_bar {
            id = "spraute_chat_bar"
            size = [bar_w, bar_h]
            pos = ["center", -40]
            background = "#00000000"

            clip("chat_clip") {
                pos = [0, 0]
                size = [bar_w, bar_h]
                alpha = 1.0

                rect("chat_bg") {
                    pos = [0, 0]
                    size = [bar_w, bar_h]
                    color = CHAT_BG
                }
                entity(ent_ref, "chat_head") {
                    pos = [0, 0]
                    size = [28, bar_h]
                    scale = head_scale
                    anchor_y = head_anchor_y
                    nameTag = false
                    noLookAt = true
                    noFollowCursor = true
                    noHurtAnim = true
                    animation = false
                    renderBones = "Head"
                }
                text("chat_name", shown) {
                    pos = [head_w, pad_top]
                    color = nameCol
                    scale = 1.0
                    layer = 1
                }
                text("textText", text) {
                    pos = [head_w, pad_top + name_h]
                    color = CHAT_TEXT
                    wrap = wrap_w
                    layer = 1
                }
            }
        }
    }

    overlayOpen(viewer, chat_bar)
    uiAnimate(viewer, "chat_clip", "alpha", 1.0, 0.3, "easeOut")

    async "chat_fade" {
        chatLogV(viewer, "fade/wait", "id=" + my_counter + " sec=" + chat_fade_sec)
        await time(chat_fade_sec)
        chatLogV(viewer, "fade/out", "id=" + my_counter)
        uiAnimate(viewer, "chat_clip", "alpha", 0.0, 0.5, "easeIn")
        await time(0.6)
        chatLogV(viewer, "fade/close", "id=" + my_counter)
        overlayClose(viewer, "spraute_chat_bar")
    }
}

on keybind("B") -> chat_history_kb {
    val player = _eventPlayer

    if (chat_history.size() == 0) {
        chat("§7Нет сообщений в истории.")
        return
    }

    val gap = 4
    val title_h = 25
    val panel_pad = 5
    val scroll_bottom_pad = 5

    var max_bar_w = CHAT_MIN_W
    var total_h = 0
    var i = 0
    while (i < chat_history.size()) {
        val msg = chat_history.get(i)
        val lay = chat_msg_layout(msg["name"], msg["text"])
        if (lay["bar_w"] > max_bar_w) { max_bar_w = lay["bar_w"] }
        total_h = total_h + lay["bar_h"] + gap
        i = i + 1
    }
    if (total_h > gap) { total_h = total_h - gap }

    val scroll_w = max_bar_w
    val panel_w = scroll_w + panel_pad * 2
    var scroll_h = 190
    if (total_h < scroll_h) { scroll_h = total_h }
    if (scroll_h < 40) { scroll_h = 40 }
    val panel_h = title_h + scroll_h + scroll_bottom_pad

    create ui history_ui {
        size = [panel_w, panel_h]
        background = "#EE111111"
        canClose = true

        text("title", "§6История сообщений") {
            pos = [10, 8]
            color = "#FFAA00"
            scale = 1.2
        }

        scroll("scroll_view") {
            pos = [panel_pad, title_h]
            size = [scroll_w, scroll_h]
            content_h = total_h

            var current_y = 0
            var j = 0
            while (j < chat_history.size()) {
                val msg = chat_history.get(j)
                val lay = chat_msg_layout(msg["name"], msg["text"])
                val bar_w = lay["bar_w"]
                val bar_h = lay["bar_h"]
                val wrap_w = lay["wrap_w"]
                val head_w = lay["head_w"]
                val pad_top = lay["pad_top"]
                val name_h = lay["name_h"]

                var hist_who = msg["who"]
                if (hist_who == null || hist_who == "") { hist_who = "npc" }
                var hist_ent = chat_entity_ref(msg["npc"])
                val hist_scale = chat_head_scale(msg["headScale"])
                val hist_ay = chat_head_anchor_y(msg["anchorYVal"])

                # Same block as live chat: bg + name + text (+ head).
                rect("bg_" + j) {
                    pos = [0, current_y]
                    size = [bar_w, bar_h]
                    color = CHAT_BG
                }

                if (hist_who == "player") {
                    val hist_skin_tex = getPlayerSkinTexture(msg["skinPlayer"])
                    val head_sz = 16
                    val hat_sz = 18
                    val head_x = 6
                    val head_y = (bar_h - head_sz) // 2
                    val hat_x = 5
                    val hat_y = head_y - 1

                    image("hist_head_" + j, hist_skin_tex + "/head") {
                        pos = [head_x, current_y + head_y]
                        size = [head_sz, head_sz]
                    }
                    image("hist_hat_" + j, hist_skin_tex + "/hat") {
                        pos = [hat_x, current_y + hat_y]
                        size = [hat_sz, hat_sz]
                        layer = 1
                    }
                } else {
                    entity(hist_ent, "hist_head_" + j) {
                        pos = [0, current_y]
                        size = [28, bar_h]
                        scale = hist_scale
                        anchor_y = hist_ay
                        nameTag = false
                        noLookAt = true
                        noFollowCursor = true
                        noHurtAnim = true
                        animation = false
                        renderBones = "Head"
                    }
                }

                text("name_" + j, formatChatName(msg["name"])) {
                    pos = [head_w, current_y + pad_top]
                    color = chat_resolve_color(msg["color"])
                    scale = 1.0
                    layer = 1
                }
                text("textText" + j, msg["text"]) {
                    pos = [head_w, current_y + pad_top + name_h]
                    color = CHAT_TEXT
                    wrap = wrap_w
                    layer = 1
                }

                current_y = current_y + bar_h + gap
                j = j + 1
            }
        }
    }

    uiOpen(player, history_ui)
}
