# ================================================================
#  Диалог с выбором — кинематографическая камера
#  import("dialog_cinematic")
#
#  async {
#      val pick = dialogCinematic(player, npc, "Вопрос?", list("Да", "Нет"))
#      val idx = dialogCinePickIndex(pick)
#  }
#
#  Камера подлетает спереди и чуть сбоку от НИПа, смотрит на него.
#  Вопрос — снизу, ответы — слева сверху (с фоном кнопок).
# ================================================================

fun dialogCineAbs(n) {
    if (n < 0) { return 0 - n }
    return n
}

fun dialogCinePickIndex(pick) {
    if (pick == null) { return -1 }
    if (pick == "__close__") { return -1 }
    if (pick.contains("dlg_cine_ans_")) {
        return pick.replace("dlg_cine_ans_", "").toInt()
    }
    return -1
}

fun dialogCinePickText(pick, answers) {
    val idx = dialogCinePickIndex(pick)
    if (idx < 0) { return "" }
    if (answers == null) { return "" }
    if (idx >= answers.size()) { return "" }
    return answers[idx]
}

# Позиция камеры: перед НИПом (со стороны игрока) + боковой сдвиг
fun dialogCineCamPos(target, player, dist, side) {
    val dx = player.x - target.x
    val dz = player.z - target.z
    val ax = dialogCineAbs(dx)
    val az = dialogCineAbs(dz)
    var m = ax
    if (az > m) { m = az }
    if (m < 0.05) {
        dx = 0
        dz = 1
        m = 1
    }
    val nx = dx / m
    val nz = dz / m
    val px = 0 - nz
    val pz = nx
    val cx = target.x + nx * dist + px * side
    val cy = target.y + 1.55
    val cz = target.z + nz * dist + pz * side
    return list(cx, cy, cz)
}

fun dialogCinematic(player, target, question, answers) {
    if (player == null) { return "__close__" }
    if (target == null) { return "__close__" }
    if (question == null) { question = "" }
    if (answers == null) { return "__close__" }

    var count = answers.size()
    if (count < 1) { return "__close__" }
    if (count > 3) { count = 3 }

    target.alwaysLookAt(player)

    val cam = dialogCineCamPos(target, player, 2.9, 0.85)
    val cx = listGet(cam, 0)
    val cy = listGet(cam, 1)
    val cz = listGet(cam, 2)

    # hideGui по умолчанию — скрывает руку и HUD; uiOpen даёт курсор и клики
    animateCameraLookAt(player, cx, cy, cz, target, 1.5, true, true)
    await time(1.6)

    create ui dlg_cinematic {
        id = "dlg_cinematic"
        size = ["100%", "100%"]
        pos = [0, 0]
        background = "#00000000"
        can_close = true
        dim_background = false

        var ai = 0
        while (ai < count) {
            val label = answers[ai]
            button("dlg_cine_ans_" + ai.toInt(), label) {
                pos = [16, 16 + ai * 34]
                size = [300, 30]
                color = "#CC243044"
                hover = "#EE3A5070"
                labelWrap = 288
                labelScale = 1.0
                layer = 2
            }
            ai = ai + 1
        }

        rect("q_bar") {
            pos = [60, "84%"]
            size = [540, 58]
            color = "#DD111828"
            layer = 0
        }

        text("q_text", question) {
            pos = [80, "86%"]
            wrap = 500
            align = "left"
            color = "#EAEAEA"
            scale = 1.05
            layer = 1
        }
    }

    uiOpen(player, dlg_cinematic)
    val pick = await uiClick(player)
    uiClose(player)

    stopCamera(player, 0.9)
    await time(1.0)
    resetCamera(player)

    return pick
}
