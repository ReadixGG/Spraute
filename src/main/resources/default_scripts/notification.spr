# Библиотека всплывающих уведомлений
# import("notification")
#
# notify(player, text)                         — показ 3 сек, без иконки
# notifyEx(player, text, hold, icon)           — hold в секундах; icon: null, id блока или путь текстуры
# notifyBlock(player, text, hold, blockId)      — иконка-блок справа от текста
# notifyTexture(player, text, hold, texture)    — иконка-текстура справа от текста
#
# Анимация: панель выезжает слева сверху → пауза → уезжает вниз и исчезает.
# Размеры панели считаются по strWidth() и переносу строк.

global val NOTIF_HOLD_SEC = 3
global val NOTIF_MSG_COUNTER = 0

global val NOTIF_MARGIN_X = 12
global val NOTIF_MARGIN_Y = 12
global val NOTIF_PAD = 8
global val NOTIF_ICON_SIZE = 20
global val NOTIF_ICON_GAP = 6
global val NOTIF_MIN_W = 72
global val NOTIF_MAX_W = 300
global val NOTIF_LINE_H = 10
global val NOTIF_SLIDE_IN = 0.45
global val NOTIF_SLIDE_OUT = 0.5
global val NOTIF_OVERLAY_ID = "spraute_notification"

fun notify(player, text) {
    notifyEx(player, text, NOTIF_HOLD_SEC, null)
}

fun notifyEx(player, text, hold, icon) {
    if (player == null) { return }
    if (text == null) { text = "" }

    var holdSec = hold
    if (holdSec == null) { holdSec = NOTIF_HOLD_SEC }
    if (holdSec <= 0) { holdSec = NOTIF_HOLD_SEC }

    var iconKind = "none"
    var iconValue = ""
    if (icon != null) {
        if (icon != "") {
            iconValue = icon
            if (icon.contains("/")) {
                iconKind = "texture"
            } else {
                iconKind = "block"
            }
        }
    }

    notifyShow(player, text, holdSec, iconKind, iconValue)
}

fun notifyBlock(player, text, hold, blockId) {
    var holdSec = hold
    if (holdSec == null) { holdSec = NOTIF_HOLD_SEC }
    if (holdSec <= 0) { holdSec = NOTIF_HOLD_SEC }
    notifyShow(player, text, holdSec, "block", blockId)
}

fun notifyTexture(player, text, hold, texture) {
    var holdSec = hold
    if (holdSec == null) { holdSec = NOTIF_HOLD_SEC }
    if (holdSec <= 0) { holdSec = NOTIF_HOLD_SEC }
    notifyShow(player, text, holdSec, "texture", texture)
}

fun notif_wrapped_lines(text, wrap_w) {
    var text_w = strWidth(text)
    if (text_w <= wrap_w) { return 1 }
    return (text_w // wrap_w) + 1
}

fun notif_calc_layout(text, iconKind) {
    val pad = NOTIF_PAD
    val line_h = NOTIF_LINE_H
    val icon_sz = NOTIF_ICON_SIZE
    val icon_gap = NOTIF_ICON_GAP
    val min_w = NOTIF_MIN_W
    val max_w = NOTIF_MAX_W

    var icon_extra = 0
    if (iconKind != "none") {
        icon_extra = icon_gap + icon_sz
    }

    var max_text_w = max_w - (pad * 2) - icon_extra
    if (max_text_w < 40) { max_text_w = 40 }

    var raw_text_w = strWidth(text) + 4
    var text_w = raw_text_w
    if (text_w > max_text_w) { text_w = max_text_w }

    var wrap_w = text_w
    var lines = notif_wrapped_lines(text, wrap_w)
    if (lines > 1) {
        text_w = max_text_w
        wrap_w = max_text_w
        lines = notif_wrapped_lines(text, wrap_w)
    }

    var bar_w = (pad * 2) + text_w + icon_extra
    if (bar_w < min_w) { bar_w = min_w }
    wrap_w = bar_w - (pad * 2) - icon_extra
    lines = notif_wrapped_lines(text, wrap_w)

    var bar_h = (pad * 2) + (lines * line_h)
    var min_h = 28
    if (iconKind != "none") {
        if (bar_h < icon_sz + (pad * 2)) {
            bar_h = icon_sz + (pad * 2)
        }
    }
    if (bar_h < min_h) { bar_h = min_h }

    var text_y = pad
    if (lines == 1) {
        text_y = (bar_h - line_h) // 2
        if (text_y < pad) { text_y = pad }
    }

    var icon_x = bar_w - pad - icon_sz
    var icon_y = (bar_h - icon_sz) // 2
    if (icon_y < pad) { icon_y = pad }

    return dict(
        "bar_w", bar_w,
        "bar_h", bar_h,
        "wrap_w", wrap_w,
        "text_x", pad,
        "text_y", text_y,
        "icon_x", icon_x,
        "icon_y", icon_y,
        "icon_sz", icon_sz
    )
}

fun notifyShow(player, text, holdSec, iconKind, iconValue) {
    stopTask("notif_anim")
    overlayClose(player, NOTIF_OVERLAY_ID)

    NOTIF_MSG_COUNTER = NOTIF_MSG_COUNTER + 1
    val my_counter = NOTIF_MSG_COUNTER

    val layout = notif_calc_layout(text, iconKind)
    val bar_w = layout["bar_w"]
    val bar_h = layout["bar_h"]
    val wrap_w = layout["wrap_w"]
    val text_x = layout["text_x"]
    val text_y = layout["text_y"]
    val icon_x = layout["icon_x"]
    val icon_y = layout["icon_y"]
    val icon_sz = layout["icon_sz"]

    val final_x = NOTIF_MARGIN_X
    val final_y = NOTIF_MARGIN_Y
    val start_x = -bar_w - 16
    val start_y = -bar_h - 16
    val exit_y = final_y + bar_h + 80

    if (iconKind == "block") {
        create ui notif_hud {
            id = NOTIF_OVERLAY_ID
            size = ["100%", "100%"]
            background = "#00000000"
            can_close = false

            clip("notif_clip") {
                pos = [start_x, start_y]
                size = [bar_w, bar_h]
                alpha = 1.0

                rect("notif_bg") {
                    pos = [0, 0]
                    size = [bar_w, bar_h]
                    color = "#DD1A1A1A"
                }
                text("notif_text", text) {
                    pos = [text_x, text_y]
                    color = "#FFFFFF"
                    wrap = wrap_w
                    scale = 1.0
                }
                item("notif_icon", iconValue) {
                    pos = [icon_x, icon_y]
                    size = icon_sz
                    layer = 1
                }
            }
        }
    } else if (iconKind == "texture") {
        create ui notif_hud {
            id = NOTIF_OVERLAY_ID
            size = ["100%", "100%"]
            background = "#00000000"
            can_close = false

            clip("notif_clip") {
                pos = [start_x, start_y]
                size = [bar_w, bar_h]
                alpha = 1.0

                rect("notif_bg") {
                    pos = [0, 0]
                    size = [bar_w, bar_h]
                    color = "#DD1A1A1A"
                }
                text("notif_text", text) {
                    pos = [text_x, text_y]
                    color = "#FFFFFF"
                    wrap = wrap_w
                    scale = 1.0
                }
                image("notif_icon", iconValue) {
                    pos = [icon_x, icon_y]
                    size = [icon_sz, icon_sz]
                    layer = 1
                }
            }
        }
    } else {
        create ui notif_hud {
            id = NOTIF_OVERLAY_ID
            size = ["100%", "100%"]
            background = "#00000000"
            can_close = false

            clip("notif_clip") {
                pos = [start_x, start_y]
                size = [bar_w, bar_h]
                alpha = 1.0

                rect("notif_bg") {
                    pos = [0, 0]
                    size = [bar_w, bar_h]
                    color = "#DD1A1A1A"
                }
                text("notif_text", text) {
                    pos = [text_x, text_y]
                    color = "#FFFFFF"
                    wrap = wrap_w
                    scale = 1.0
                }
            }
        }
    }

    overlayOpen(player, notif_hud)
    uiAnimate(player, "notif_clip", "x", final_x, NOTIF_SLIDE_IN, "easeOut")
    uiAnimate(player, "notif_clip", "y", final_y, NOTIF_SLIDE_IN, "easeOut")

    async "notif_anim" {
        await time(NOTIF_SLIDE_IN + 0.05)
        if (my_counter != NOTIF_MSG_COUNTER) { return }

        await time(holdSec)
        if (my_counter != NOTIF_MSG_COUNTER) { return }

        uiAnimate(player, "notif_clip", "y", exit_y, NOTIF_SLIDE_OUT, "easeIn")
        uiAnimate(player, "notif_clip", "alpha", 0.0, NOTIF_SLIDE_OUT, "easeIn")
        await time(NOTIF_SLIDE_OUT + 0.1)
        if (my_counter != NOTIF_MSG_COUNTER) { return }

        overlayClose(player, NOTIF_OVERLAY_ID)
    }
}
