# Тест: показать текстуру скина игрока на экране 5 секунд
# Запуск: startScript("skin_test")

val player = getFirstPlayer()
if (player == null) {
    player = getNearestPlayer()
}
if (player == null) {
    chat("§c[skin_test] Нет игрока онлайн.")
} else {
    val skinTex = getPlayerSkinTexture(player)
    val skinUrl = getPlayerSkinUrl(player)

    create ui skin_test_ui {
        id = "skin_test_ui"
        size = [320, 220]
        pos = ["center", "center"]
        background = "#DD111111"
        canClose = true

        text("title", "skin_test — текстура скина") {
            pos = [10, 8]
            color = "#FFAA00"
            scale = 1.0
        }
        text("tex_line", "texture: " + skinTex) {
            pos = [10, 26]
            color = "#AAAAAA"
            scale = 0.85
        }
        text("url_line", "url: " + skinUrl) {
            pos = [10, 40]
            color = "#777777"
            scale = 0.7
            wrap = 300
        }
        rect("frame") {
            pos = [86, 58]
            size = [148, 148]
            color = "#FF333333"
        }
        image("skin_img", skinTex) {
            pos = [90, 62]
            size = [140, 140]
        }
    }

    overlayOpen(player, skin_test_ui)
    chat("§a[skin_test] Скин на экране 5 сек. §7" + skinTex)

    async {
        await time(5)
        overlayClose(player, "skin_test_ui")
    }
}
