global val SHOP_COLS     = 5
global val SHOP_CELL_W   = 54
global val SHOP_CELL_H   = 70
global val SHOP_ROW_GAP  = 6
global val SHOP_PAD_TOP  = 6
global val SHOP_HDR_H    = 36

global val shopCtx = dictCreate()

global var rayaNpc   = null
global val rayaState = dictCreate()
global val rayaTimer = dictCreate()
# false — таймер следования не трогает Райю (диалоги, кат-сцены)
global var rayaFollowEnabled = true
# Режим следования: "auto" (по умолчанию) | "back" (всегда за спиной, смотрит вперёд) | "front" (подлетает спереди, смотрит на игрока)
global var rayaFollowMode = "auto"

# ─────────────────────────────────────────────────────────────────
#  ПМ
# ─────────────────────────────────────────────────────────────────
fun pmGet(p) {
    if (p == null) { return 0 }
    val v = p.savedData["pm"]
    if (v == null) { return 0 }
    return v
}
fun pmSet(p, amount) {
    if (p == null) { return }
    p.savedData["pm"] = amount
}
fun pmAdd(p, amount) { pmSet(p, pmGet(p) + amount) }
fun pmSub(p, amount) { pmSet(p, pmGet(p) - amount) }

fun shopRegisterCtx(player) {
    var i = 0
    val n = listSize(SHOP_ITEMS)
    while (i < n) {
        dictSet(shopCtx, player.name + "buy" + i, listGet(SHOP_ITEMS, i))
        i = i + 1
    }
}

fun shopTryBuy(p, widgetId) {
    if (p == null) { return }
    val data = dictGetOr(shopCtx, p.name + widgetId, null)
    if (data == null) { return }
    val iId  = listGet(data, 0)
    val iCnt = listGet(data, 1)
    val iPrc = listGet(data, 2)
    val cur  = pmGet(p)
    if (cur < iPrc) {
        playSound(p, "minecraft:entity.villager.no", 0.8, 1.0)
        chat(p, "§cНедостаточно ПМ! §7(нужно §e" + iPrc + "§7, есть §e" + cur + "§7)")
        return
    }
    pmSub(p, iPrc)
    giveItem(p, iId, iCnt)
    playSound(p, "minecraft:entity.experience_orb.pickup", 0.8, 1.2)
    chat(p, "§a+§f" + iCnt + " §a" + iId)
    rayaOpenShop(p)
}

# ─────────────────────────────────────────────────────────────────
#  Спавн Райи — ищем существующую рядом, иначе создаём новую
# ─────────────────────────────────────────────────────────────────
fun configureRayaNpc(player) {
    raya.setFlying(true)
    raya.setFlyIdleAnim("idle")
    raya.setFlyWalkAnim("idle")
    raya.setHeadLookUnlimited(true)
    raya.flySpeed = 1.2
    raya.flySmoothing = 0.28
    raya.nameYOffset = 1.1

    dictSet(rayaState, player.name, "follow")
    dictSet(rayaTimer, player.name, 0.0)

    on interact(raya) -> rayaInteract {
        val p = _eventPlayer
        if (p == null) { return }
        rayaOpenShop(p)
    }
}

fun findRayaNpc(player) {
    val tracked = getNpc("raya")
    if (tracked != null && tracked.isAlive) {
        rayaNpc = tracked
        return tracked
    }
    if (player != null) {
        val nearby = getNearestNpc(player, 96, "raya")
        if (nearby != null && nearby.isAlive) {
            registerNpc("raya", nearby)
            rayaNpc = nearby
            return nearby
        }
    }
    return null
}

fun spawnRaya(player) {
    if (player == null) { return }

    if (rayaNpc != null && rayaNpc.isAlive) {
        registerNpc("raya", rayaNpc)
        configureRayaNpc(player)
        return
    }

    # Уже привязана к id "raya" в движке
    val tracked = getNpc("raya")
    if (tracked != null && tracked.isAlive) {
        rayaNpc = tracked
        configureRayaNpc(player)
        return
    }

    # Осиротевшая Райя в мире (после перезахода / reload без трекинга)
    val nearby = getNearestNpc(player, 48, "raya")
    if (nearby != null && nearby.isAlive) {
        registerNpc("raya", nearby)
        rayaNpc = nearby
        configureRayaNpc(player)
        return
    }

    rayaNpc = null

    create npc raya {
        name        = "§dРайя"
        hp          = 200
        speed       = 0
        pos         = player.x, player.y + 1.5, player.z - 1.8
        model       = "geo/raya.geo.json"
        texture     = "textures/entity/raya.png"
        animation   = "animations/raya.animation.json"
        idleAnim    = "idle"
        walkAnim    = "idle"
        flyIdleAnim = "idle"
        flyWalkAnim = "idle"
        hitbox      = 1.0, 1.0, 0, 1, 0
        dropItem    = "raya_implant_broken"
        dropChance  = 100
        dropMin     = 1
        dropMax     = 1
    }

    rayaNpc = raya
    configureRayaNpc(player)
}

# Запуск сразу при старте скрипта (игрок уже в мире)
spawnRaya(getFirstPlayer())

# И при каждом новом подключении
on join() -> rayaJoin {
    val p = _eventPlayer
    if (p == null) { return }
    spawnRaya(p)
}

# Клавиша X — переключает режим следования Райи: back -> front -> auto -> back ...
on keybind("x") -> rayaToggleMode {
    val p = _eventPlayer
    if (rayaFollowMode == "back") {
        rayaFollowMode = "front"
        if (p != null) { chat(p, "§dРайя §7подлетает спереди") }
    } else {
        if (rayaFollowMode == "front") {
            rayaFollowMode = "auto"
            if (p != null) { chat(p, "§dРайя §7следует автоматически") }
        } else {
            rayaFollowMode = "back"
            if (p != null) { chat(p, "§dРайя §7держится за спиной") }
        }
    }
}

# ─────────────────────────────────────────────────────────────────
#  ИИ компаньона
# ─────────────────────────────────────────────────────────────────
# ВАЖНО: внутри every(...) НЕЛЬЗЯ использовать return — он навсегда останавливает таймер.
# Вся логика построена на вложенных if/else без ранних выходов.
every(0.1) -> rayaTick {
    val player = getFirstPlayer()
    if (rayaFollowEnabled) { if (rayaNpc != null) { if (player != null) {
        val motion = getPlayerMotion(player)
        val hspd2  = motion[0] * motion[0] + motion[2] * motion[2]
        val facing = getPlayerFacing(player)
        val hx     = facing["hx"]
        val hz     = facing["hz"]
        val state  = dictGetOr(rayaState, player.name, "follow")
        val timer  = dictGetOr(rayaTimer, player.name, 0.0)
        val by     = player.y + RAYA_HEIGHT

        # Ручные режимы по клавише X имеют приоритет над авто-логикой
        if (rayaFollowMode == "back") {
            val mbx = player.x - hx * RAYA_BACK_DIST
            val mbz = player.z - hz * RAYA_BACK_DIST
            rayaNpc.alwaysFlyTo(mbx, by, mbz, 1.0)
            rayaNpc.alwaysLookAt(player)
        } else { if (rayaFollowMode == "front") {
            val mfx = player.x + hx * RAYA_FRONT_DIST
            val mfz = player.z + hz * RAYA_FRONT_DIST
            rayaNpc.alwaysFlyTo(mfx, by, mfz, 1.0)
            rayaNpc.alwaysLookAt(player)
        } else {
            # Авто-режим
            if (hspd2 > RAYA_MOVE_THR) {
                dictSet(rayaTimer, player.name, 0.0)
                if (state != "follow") { dictSet(rayaState, player.name, "follow") }
                val bx = player.x - hx * RAYA_BACK_DIST
                val bz = player.z - hz * RAYA_BACK_DIST
                rayaNpc.alwaysFlyTo(bx, by, bz, 1.0)
                rayaNpc.alwaysLookAt(player)
            } else {
                val newTimer = timer + 0.1
                dictSet(rayaTimer, player.name, newTimer)
                if (newTimer >= RAYA_STOP_DELAY) {
                    if (state != "greet") { dictSet(rayaState, player.name, "greet") }
                    val fx = player.x + hx * RAYA_FRONT_DIST
                    val fz = player.z + hz * RAYA_FRONT_DIST
                    rayaNpc.alwaysFlyTo(fx, by, fz, 0.5)
                    rayaNpc.alwaysLookAt(player)
                } else {
                    val bx = player.x - hx * RAYA_BACK_DIST
                    val bz = player.z - hz * RAYA_BACK_DIST
                    rayaNpc.alwaysFlyTo(bx, by, bz, 0.6)
                    rayaNpc.alwaysLookAt(player)
                }
            }
        } }
    } } }
}

# ─────────────────────────────────────────────────────────────────
#  Магазин — одна страница, прокрутка вверх/вниз
# ─────────────────────────────────────────────────────────────────
fun rayaOpenShop(player) {
    if (player == null) { return }

    val pm         = pmGet(player)
    val totalItems = listSize(SHOP_ITEMS)
    val rows       = (totalItems + SHOP_COLS - 1) / SHOP_COLS
    val contentH   = SHOP_PAD_TOP + rows * (SHOP_CELL_H + SHOP_ROW_GAP) + 8

    shopRegisterCtx(player)

    create ui shopUi {
        size       = [300, 340]
        background = "#00000000"
        canClose   = true

        image("shopBg", GUI_TEX_BG) {
            pos          = [0, 0]
            size         = [300, 340]
            sliceBorders = GUI_SLICE_BG
            sliceScale   = GUI_SCALE_BG
            layer        = 0
        }

        # Шапка — отдельная плашка с отступами, поверх фона
        image("hdrBg", GUI_TEX_PLASHKA) {
            pos          = [8, 6]
            size         = [284, SHOP_HDR_H]
            sliceBorders = GUI_SLICE_PLASHKA
            sliceScale   = GUI_SCALE_PLASHKA
            layer        = 2
        }
        text("shopTitle", "§l§b$ SHOP $") {
            pos   = [18, 10]
            color = "#55CCFF"
            scale = 1.2
            layer = 3
        }
        text("shopPm", "§7Баланс: §e§l" + pm + " §7ПМ") {
            pos   = [18, 26]
            color = "#FFEE88"
            scale = 0.88
            layer = 3
        }
        text("shopHint", "§8листайте вниз") {
            pos   = [210, 24]
            color = "#666666"
            scale = 0.7
            layer = 3
        }
        divider("divTop") {
            pos   = [10, 46]
            size  = [280, 1]
            color = "#33FFFFFF"
            layer = 3
        }

        scroll("shopScroll") {
            pos        = [8, 52]
            size       = [284, 280]
            contentH   = contentH
            scrollbar  = true
            color      = "#11000000"
            layer      = 1

            var col = 0
            var row = 0
            var idx = 0
            while (idx < totalItems) {
                val entry     = listGet(SHOP_ITEMS, idx)
                val itemId    = listGet(entry, 0)
                val itemCount = listGet(entry, 1)
                val itemPrice = listGet(entry, 2)
                val px        = col * SHOP_CELL_W
                val py        = SHOP_PAD_TOP + row * (SHOP_CELL_H + SHOP_ROW_GAP)

                image("bg" + idx, GUI_TEX_PLASHKA) {
                    pos          = [px, py]
                    size         = [50, SHOP_CELL_H]
                    sliceBorders = GUI_SLICE_PLASHKA
                    sliceScale   = GUI_SCALE_PLASHKA
                }
                item("itm" + idx, itemId) {
                    pos = [px + 17, py + 5]
                }
                text("cnt" + idx, "x" + itemCount) {
                    pos   = [px + 9, py + 24]
                    color = "#BBBBBB"
                    scale = 0.78
                }
                text("prc" + idx, "§e" + itemPrice + " ПМ") {
                    pos   = [px + 9, py + 36]
                    color = "#FFEE55"
                    scale = 0.75
                }
                button("buy" + idx, "§aКупить") {
                    pos          = [px + 3, py + 52]
                    size         = [44, 14]
                    texture      = GUI_TEX_BTN
                    sliceBorders = GUI_SLICE_BTN
                    sliceScale   = GUI_SCALE_BTN
                    color        = "#00000000"
                    hover        = "#33FFFFFF"
                    onClick { shopTryBuy(_eventPlayer, _eventWidget) }
                }

                col = col + 1
                if (col >= SHOP_COLS) {
                    col = 0
                    row = row + 1
                }
                idx = idx + 1
            }
        }
    }

    uiOpen(player, shopUi)
}

# ─────────────────────────────────────────────────────────────────
#  Заработок ПМ
# ─────────────────────────────────────────────────────────────────
on kill("player", "mob") -> rayaOnKill {
    val p = _eventKiller
    if (p == null) { return }
    pmAdd(p, PM_MOB_KILL)
    chat(p, "§d+§f" + PM_MOB_KILL + " §dПМ §8(убийство)")
}

on breakBlock() -> rayaOnMine {
    val p = _eventPlayer
    if (p == null) { return }
    val reward = dictGetOr(ORE_PM, _eventBlock, 0)
    if (reward <= 0) { return }
    pmAdd(p, reward)
    chat(p, "§d+§f" + reward + " §dПМ §8(руда)")
}

# ─────────────────────────────────────────────────────────────────
#  Использование импланта — ПКМ → спавн Райи
# ─────────────────────────────────────────────────────────────────
on action("use", "raya_implant") -> rayaOnUseImplant {
    val p = _eventPlayer
    if (p == null) { return }
    if (rayaNpc != null && rayaNpc.isAlive) {
        chat(p, "§cРайя уже активна!")
        return
    }
    rayaNpc = null
    removeItem(p, "raya_implant", 1)
    spawnRaya(p)
    if (rayaNpc != null) {
        npcChat(p, rayaNpc, "Привет, " + p.name + "!", "#FFFFFF", null, 0.4)
    }
}

on death(raya) -> rayaOnDeath {
    rayaNpc = null
}
