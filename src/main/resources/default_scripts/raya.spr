create item battery {
    name         = "Батарея"
    texture      = "textures/item/battery.png"
    maxStackSize = 16
}

create item raya_implant_broken {
    name         = "Неактивный имплант §7[Сломан]"
    texture      = "textures/item/inactive_implant.png"
    maxStackSize = 1
}

create item raya_implant {
    name         = "Неактивный имплант"
    texture      = "textures/item/inactive_implant.png"
    maxStackSize = 1
}

# ── Крафты ────────────────────────────────────────────────────────
create craft battery_recipe {
    type         = "shapeless"
    ingredients  = ["minecraft:iron_ingot", "minecraft:iron_ingot", "minecraft:iron_ingot", "minecraft:iron_ingot", "minecraft:redstone", "minecraft:redstone", "minecraft:redstone", "minecraft:redstone"]
    result       = "battery"
    count        = 1
}

create craft raya_implant_recipe {
    type         = "shapeless"
    ingredients  = ["raya_implant_broken", "battery"]
    result       = "raya_implant"
    count        = 1
}

