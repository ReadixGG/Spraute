# ================================================================
#  Spraute Progression — уровни, очки, статы и навыки
#  Запуск: /spraute run progression
#  import("progression") — API в других скриптах
#  Меню прокачки: клавиша P
# ================================================================

val PROG_XP_KILL = 8
val PROG_XP_BREAK = 3
val PROG_XP_PLACE = 2
val PROG_XP_CRAFT = 5
val PROG_SKILL_MAX = 3
val PROG_STAT_MAX = 30

global val PROG_SKILL_IDS = [
    "c_slayer", "c_vampire", "c_cleave",
    "m_wide", "m_spark", "m_vein",
    "w_scaffold", "w_djump", "w_dash"
]
global val PROG_SKILL_NAMES = [
    "Охотник", "Вампиризм", "Рассекатель",
    "Широкий разрез", "Искры руды", "Жила",
    "Леса", "Двойной прыжок", "Рывок"
]
global val PROG_SKILL_DESCS = [
    "Бонус опыта за убийства: +25% / +50% / +75%",
    "Лечение при убийстве: 1 / 2 / 3 сердца",
    "Урон по мобам рядом с жертвой: радиус 2 / 3 / 4",
    "Копает полосу 3×1 / 3×2 / 3×3 влево-вправо на грани блока (не вглубь)",
    "Скорость копания +5% / +10% / +15% за уровень",
    "Бонус опыта за добычу: +1 / +2 / +3",
    "Высота шага +0.5 / +1.0 / +2.0 блока",
    "Прыжки в воздухе: 1 / 2 / 3 за приземление",
    "Рывок по двойному Shift: сила 0.5 / 0.8 / 1.1 блоков"
]

# Состояние прокачки хранится в player.savedData (см. progInit)

fun progIsPlayer(p) {
    if (p == null) { return false }
    if (p.savedData == null) { return false }
    return true
}

fun progSkipBreak(p) {
    if (p == null) { return false }
    var v = p.savedData["prog_skip_break"]
    if (v == null) { return false }
    return v
}

fun progSetSkipBreak(p, flag) {
    if (p == null) { return }
    p.savedData["prog_skip_break"] = flag
}

# ──── Инициализация и данные ────

fun progXpToLevel(lvl) {
    if (lvl == null) { lvl = 1 }
    if (lvl < 1) { lvl = 1 }
    return 2000 + (lvl - 1) * 500
}

fun progInit(p) {
    if (p == null) { return }
    val d = p.savedData
    if (d == null) { return }
    if (d["prog_level"] == null) {
        d["prog_level"] = 1
        d["prog_xp"] = 0
        d["prog_max_xp"] = 2000
        d["prog_points"] = 0
        d["stat_dmg"] = 0
        d["stat_spd"] = 0
        d["stat_dig"] = 0
    }
    if (d["prog_points"] == null) { d["prog_points"] = 0 }
    if (d["prog_xp"] == null) { d["prog_xp"] = 0 }
    if (d["prog_max_xp"] == null || d["prog_max_xp"] < 1000) {
        d["prog_max_xp"] = progXpToLevel(d["prog_level"])
    }
    var si = 0
    while (si < listSize(PROG_SKILL_IDS)) {
        val sid = PROG_SKILL_IDS[si]
        if (d[sid] == null) {
            if (sid == "w_scaffold" && d["b_scaffold"] != null) {
                d[sid] = d["b_scaffold"]
            } else {
                d[sid] = 0
            }
        }
        si = si + 1
    }
}

fun progSkillLvl(p, id) {
    progInit(p)
    var key = id
    if (id == "w_scaffold") {
        var migrated = p.savedData["w_scaffold"]
        if (migrated == null) {
            migrated = p.savedData["b_scaffold"]
        }
        if (migrated == null) { return 0 }
        return migrated
    }
    var v = p.savedData[key]
    if (v == null) { return 0 }
    return v
}

fun progSkillCost(p, id) {
    var lvl = progSkillLvl(p, id)
    return 2 ** lvl
}

fun progSkillHoverText(p, id, name, desc) {
    var lvl = progSkillLvl(p, id)
    var txt = "§l" + name + "§r\n§7" + desc + "\n§fУровень: §e" + lvl + " / " + PROG_SKILL_MAX
    if (lvl < PROG_SKILL_MAX) {
        txt = txt + "\n§7Стоимость: §e" + progSkillCost(p, id) + " очк."
    } else {
        txt = txt + "\n§aМаксимум"
    }
    return txt
}

fun progStatHoverText(p, key, name, desc) {
    progInit(p)
    var lvl = p.savedData[key]
    if (lvl == null) { lvl = 0 }
    var txt = "§l" + name + "§r\n§7" + desc + "\n§fУровень: §e" + lvl + " / " + PROG_STAT_MAX
    if (lvl < PROG_STAT_MAX) {
        txt = txt + "\n§7Стоимость: §e1 очко"
    } else {
        txt = txt + "\n§aМаксимум"
    }
    return txt
}

fun progSkillTooltip(p, id, name, desc) {
    return progSkillHoverText(p, id, name, desc)
}

fun progStatTooltip(p, key, name, desc) {
    return progStatHoverText(p, key, name, desc)
}

fun progApplyStats(p) {
    if (p == null) { return }
    progInit(p)
    val d = p.savedData
    var dmg = 1.0 + d["stat_dmg"] * 0.5
    var spd = 0.1 + d["stat_spd"] * 0.01
    var noSpd = d["prog_no_spd"]
    if (noSpd == null) { noSpd = 0 }
    if (noSpd > 0) { spd = 0.1 }
    var dig = 1.0 + d["stat_dig"] * 0.1
    var spark = progSkillLvl(p, "m_spark")
    if (spark > 0) { dig = dig + spark * 0.05 }
    var sc = progSkillLvl(p, "w_scaffold")
    var stepBonus = 0
    if (sc == 1) { stepBonus = 0.5 }
    if (sc == 2) { stepBonus = 1.0 }
    if (sc == 3) { stepBonus = 2.0 }
    var step = 0.6 + stepBonus
    setPlayerAttackDamage(p, dmg)
    setPlayerMovementSpeed(p, spd)
    setPlayerDigSpeed(p, dig)
    setPlayerStepHeight(p, step)
}

fun progUpdateMenuXp(p) {
    if (p == null) { return }
    progInit(p)
    val d = p.savedData
    var lvl = d["prog_level"]
    var xp = d["prog_xp"]
    var max_xp = d["prog_max_xp"]
    var pts = d["prog_points"]
    if (pts == null) { pts = 0 }
    uiUpdate(p, "pm_info", "text", "Ур. " + lvl + "  |  Очки: " + pts)
    uiUpdate(p, "pm_xp_lbl", "text", "Опыт: " + xp + " / " + max_xp)
    var pct = 0
    if (max_xp > 0) { pct = (xp * 100) / max_xp }
    var w = (pct * 336) / 100
    if (w < 1) { w = 1 }
    if (pct == 0) { w = 0 }
    uiUpdate(p, "pm_xp_fill", "w", w)
}

fun progAddXp(p, amount, source) {
    if (p == null) { return }
    if (amount < 1) { return }
    if (!progIsPlayer(p)) { return }
    progInit(p)
    val d = p.savedData
    if (d == null) { return }

    if (source == "kill") {
        var sl = progSkillLvl(p, "c_slayer")
        if (sl > 0) { amount = amount + (amount * sl * 25) // 100 }
    }
    if (source == "break") {
        var vn = progSkillLvl(p, "m_vein")
        if (vn > 0) { amount = amount + vn }
    }

    d["prog_xp"] = d["prog_xp"] + amount
    var leveled = false
    while (d["prog_xp"] >= d["prog_max_xp"]) {
        d["prog_xp"] = d["prog_xp"] - d["prog_max_xp"]
        d["prog_level"] = d["prog_level"] + 1
        d["prog_max_xp"] = progXpToLevel(d["prog_level"])
        d["prog_points"] = d["prog_points"] + 1
        leveled = true
    }

    if (leveled) {
        playSound(p, "minecraft:entity.player.levelup", 1.0, 1.2)
        chat(p, "§b§lПрокачка! §r§7Уровень §e" + d["prog_level"] + "§7 — получено §e1§7 очко.")
        particleSpawn("minecraft:totem_of_undying", p.x, p.y + 1.0, p.z, 24, 0.35, 0.4, 0.35, 0.1)
        particleCircle("minecraft:enchant", p.x, p.y + 0.2, p.z, 1.2, 16, 0, 0.1, 0, 0.02)
        particleSpiral("minecraft:end_rod", p.x, p.y, p.z, 1.0, 2.0, 20, 0, 0, 0, 0)
    }

    progUpdateMenuXp(p)
}

# ──── Навыки: добыча и мир ────

fun progWideCut(p, bx, by, bz) {
    if (p == null) { return }
    if (p.isSneaking) { return }
    var lvl = progSkillLvl(p, "m_wide")
    if (lvl < 1) { return }

    # Влево-вправо относительно взгляда (перпендикуляр горизонтальному facing), без копания вглубь
    var f = getPlayerFacing(p)
    var wx = 0 - f["hz"]
    var wz = f["hx"]
    var midRow = 0
    if (lvl >= 3) { midRow = 1 }

    progSetSkipBreak(p, true)
    var si = 0
    while (si < lvl) {
        var yoff = si
        if (lvl >= 3) { yoff = si - 1 }
        if (lvl == 1) { yoff = 0 }
        var wi = -1
        while (wi <= 1) {
            if (si == midRow && wi == 0) {
                # центральный блок — ванильный лом
            } else {
                var nx = bx + wx * wi
                var ny = by + yoff
                var nz = bz + wz * wi
                breakBlockAt(nx, ny, nz, p)
                particleSpawn("minecraft:crit", nx + 0.5, ny + 0.5, nz + 0.5, 4, 0.15, 0.15, 0.15, 0.02)
                particleSpawn("minecraft:cloud", nx + 0.5, ny + 0.6, nz + 0.5, 2, 0.05, 0.05, 0.05, 0)
            }
            wi = wi + 1
        }
        si = si + 1
    }
    progSetSkipBreak(p, false)
    playSound(p, "minecraft:block.stone.break", 0.6, 1.1)
}

fun progToggleSpeed(p) {
    if (p == null) { return }
    progInit(p)
    var off = p.savedData["prog_no_spd"]
    if (off == null) { off = 0 }
    if (off > 0) {
        p.savedData["prog_no_spd"] = 0
        chat(p, "§aБонус скорости §7включён")
    } else {
        p.savedData["prog_no_spd"] = 1
        chat(p, "§7Бонус скорости §cвыключен")
    }
    progApplyStats(p)
    var pitch = 0.8
    if (off > 0) { pitch = 1.2 }
    playSound(p, "minecraft:ui.button.click", 0.8, pitch)
}

fun progResetAirJumps(p) {
    if (p == null) { return }
    var dj = progSkillLvl(p, "w_djump")
    if (dj > 0) {
        p.savedData["prog_dj_left"] = dj
    }
}

fun progTryAirJump(p) {
    if (p == null) { return }
    if (p.onGround) { return }
    var dj = progSkillLvl(p, "w_djump")
    if (dj < 1) { return }
    var left = p.savedData["prog_dj_left"]
    if (left == null) { left = 0 }
    if (left < 1) { return }
    p.savedData["prog_dj_left"] = left - 1
    p.savedData["prog_used_air_jump"] = 1
    resetFallDistance(p)
    var strength = 0.32 + dj * 0.1
    addPlayerMotion(p, 0, strength, 0)
    playSound(p, "minecraft:entity.ender_dragon.flap", 0.4, 1.4)
    particleSpawn("minecraft:cloud", p.x, p.y, p.z, 6, 0.2, 0.1, 0.2, 0.02)
    particleCircle("minecraft:end_rod", p.x, p.y + 0.2, p.z, 0.5, 8, 0, 0.05, 0, 0.01)
}

fun progHandleDashKey(p) {
    if (p == null) { return }
    # Двойной Shift — рывок не мешает приседанию / другим биндам на одиночное нажатие
    var tap = p.savedData["prog_dash_tap"]
    if (tap == null) { tap = 0 }
    if (tap > 0) {
        p.savedData["prog_dash_tap"] = 0
        progTryDash(p)
    } else {
        p.savedData["prog_dash_tap"] = 2
    }
}

fun progOnLand(p) {
    if (p == null) { return }
    var used = p.savedData["prog_used_air_jump"]
    if (used == null) { used = 0 }
    if (used > 0) {
        resetFallDistance(p)
        p.savedData["prog_used_air_jump"] = 0
    }
}

fun progFallSafeTick(p) {
    if (p == null) { return }
    var used = p.savedData["prog_used_air_jump"]
    if (used == null) { used = 0 }
    if (used > 0) {
        resetFallDistance(p)
    }
}

fun progTryDash(p) {
    if (p == null) { return }
    var dash = progSkillLvl(p, "w_dash")
    if (dash < 1) { return }
    var cd = p.savedData["prog_dash_cd"]
    if (cd == null) { cd = 0 }
    if (cd > 0) { return }
    p.savedData["prog_dash_cd"] = 1.6 - dash * 0.3
    var f = getPlayerFacing(p)
    var hx = f["hx"]
    var hz = f["hz"]
    var power = 0.35 + dash * 0.25
    var m = getPlayerMotion(p)
    setPlayerMotion(p, m[0] + hx * power, m[1] + 0.05, m[2] + hz * power)
    playSound(p, "minecraft:entity.phantom.flap", 0.5, 1.2)
    particleCircle("minecraft:sweep_attack", p.x, p.y + 0.5, p.z, 0.6, 10, 0, 0, 0, 0)
    particleSpawn("minecraft:cloud", p.x, p.y + 0.3, p.z, 8, 0.25, 0.05, 0.25, 0.03)
}

fun progOnKillSkills(killer, victim) {
    if (killer == null) { return }
    progInit(killer)

    var vamp = progSkillLvl(killer, "c_vampire")
    if (vamp > 0) {
        var heal = vamp * 2.0
        healEntity(killer, heal)
        particleSpawn("minecraft:heart", killer.x, killer.y + 1.2, killer.z, vamp * 2, 0.25, 0.25, 0.25, 0)
    }

    var cleave = progSkillLvl(killer, "c_cleave")
    if (cleave > 0 && victim != null) {
        var rad = 1.0 + cleave
        var nearby = entitiesNear(victim, rad, "mob")
        var ni = 0
        while (ni < listSize(nearby)) {
            var ent = nearby[ni]
            if (ent != null) {
                if (ent != victim) {
                    ent.damage(2.0 + cleave, killer)
                    particleSpawn("minecraft:crit", ent.x, ent.y + 0.8, ent.z, 5, 0.2, 0.2, 0.2, 0)
                }
            }
            ni = ni + 1
        }
        particleCircle("minecraft:sweep_attack", victim.x, victim.y + 0.5, victim.z, rad, 12, 0, 0, 0, 0)
    }
}

# ──── UI прокачки ────

fun progBuildUi(p) {
    if (p == null) { return }
    progInit(p)
    val d = p.savedData
    var pts = d["prog_points"]
    if (pts == null) { pts = 0 }
    var xp = d["prog_xp"]
    var max_xp = d["prog_max_xp"]
    var xpPct = 0
    if (max_xp > 0) { xpPct = (xp * 100) / max_xp }
    var xpW = (xpPct * 336) / 100
    if (xpPct == 0) { xpW = 0 }
    if (xpW < 1 && xpPct > 0) { xpW = 1 }

    create ui prog_menu_ui {
        size = [360, 338]
        background = "#EE1A1A2E"
        can_close = true

        text("pm_title", "§l§bПрокачка") {
            pos = [12, 8]
            color = "#55CCFF"
            scale = 1.2
        }
        text("pm_info", "Ур. " + d["prog_level"] + "  |  Очки: " + pts) {
            pos = [12, 26]
            color = "#CCCCCC"
            scale = 0.85
        }
        text("pm_xp_lbl", "Опыт: " + xp + " / " + max_xp) {
            pos = [12, 42]
            color = "#AAAAAA"
            scale = 0.78
        }
        rect("pm_xp_bg") {
            pos = [12, 56]
            size = [336, 12]
            color = "#88000000"
        }
        rect("pm_xp_fill") {
            pos = [12, 56]
            size = [xpW, 12]
            color = "#FF55AAFF"
        }
        divider("pm_div1") {
            pos = [8, 74]
            size = [344, 1]
            color = "#44FFFFFF"
        }

        text("pm_stats_lbl", "§6Общие характеристики §7(1 очко)") {
            pos = [12, 82]
            color = "#FFAA00"
            scale = 0.82
