            text("ht_djump", progSkillHoverText(p, "w_djump", PROG_SKILL_NAMES[7], PROG_SKILL_DESCS[7])) {
                pos = [8, 6]
                wrap = 210
                scale = 0.8
                color = "#DDDDDD"
            }
            on_click { progTryUpgradeSkill(_eventPlayer, "w_djump") }
        }
        button("skill_w_dash", "Рывок") {
            pos = [240, 242]
            size = [108, 22]
            color = "#55335544"
            hover = "#77557766"
            hover_size = [228, 96]
            text("ht_dash", progSkillHoverText(p, "w_dash", PROG_SKILL_NAMES[8], PROG_SKILL_DESCS[8])) {
                pos = [8, 6]
                wrap = 210
                scale = 0.8
                color = "#DDDDDD"
            }
            on_click { progTryUpgradeSkill(_eventPlayer, "w_dash") }
        }

        text("pm_hint", "§7Наведи на кнопку — панель с описанием\n§7N — вкл/выкл бонус скорости  |  P — меню") {
            pos = [12, 272]
            color = "#888888"
            scale = 0.75
            wrap = 336
        }
        button("pm_close", "Закрыть") {
            pos = [12, 306]
            size = [336, 22]
            color = "#555555"
            hover = "#777777"
            on_click {
                uiClose(_eventPlayer)
                playSound(_eventPlayer, "minecraft:ui.button.click", 1.0, 1.0)
            }
        }
    }
}

fun progReopenMenu(p) {
    if (p == null) { return }
    progBuildUi(p)
    uiOpen(p, prog_menu_ui)
}

fun progTryUpgradeStat(p, key) {
    progInit(p)
    val d = p.savedData
    var lvl = d[key]
    if (lvl == null) { lvl = 0 }
    if (lvl >= PROG_STAT_MAX) {
        playSound(p, "minecraft:block.note_block.bass", 1.0, 0.5)
        return false
    }
    if (d["prog_points"] == null) { d["prog_points"] = 0 }
    if (d["prog_points"] < 1) {
        playSound(p, "minecraft:block.note_block.bass", 1.0, 0.5)
        return false
    }
    d["prog_points"] = d["prog_points"] - 1
    d[key] = lvl + 1
    progApplyStats(p)
    playSound(p, "minecraft:entity.player.levelup", 0.8, 1.5)
    particleSpawn("minecraft:enchant", p.x, p.y + 1.0, p.z, 12, 0.3, 0.3, 0.3, 0.05)
    progReopenMenu(p)
    return true
}

fun progTryUpgradeSkill(p, id) {
    progInit(p)
    val d = p.savedData
    var lvl = progSkillLvl(p, id)
    if (lvl >= PROG_SKILL_MAX) {
        playSound(p, "minecraft:block.note_block.bass", 1.0, 0.5)
        return false
    }
    var cost = progSkillCost(p, id)
    if (d["prog_points"] == null) { d["prog_points"] = 0 }
    if (d["prog_points"] < cost) {
        playSound(p, "minecraft:block.note_block.bass", 1.0, 0.5)
        return false
    }
    d["prog_points"] = d["prog_points"] - cost
    d[id] = lvl + 1
    progApplyStats(p)
    playSound(p, "minecraft:entity.player.levelup", 0.8, 1.3)
    particleSpiral("minecraft:witch", p.x, p.y, p.z, 0.8, 1.5, 15, 0, 0, 0, 0)
    progReopenMenu(p)
    return true
}

fun progOpenMenu(p) {
    if (p == null) { return }
    progInit(p)
    progApplyStats(p)
    progBuildUi(p)
    uiOpen(p, prog_menu_ui)
}

# ──── События ────

on join() -> progJoin {
    val p = _eventPlayer
    if (p == null) { return }
    if (!progIsPlayer(p)) { return }
    progInit(p)
    progApplyStats(p)
}

on breakBlock() -> progBreak {
    val p = _eventPlayer
    if (p == null) { return }
    if (!progIsPlayer(p)) { return }
    if (progSkipBreak(p)) { return }
    progInit(p)
    progAddXp(p, PROG_XP_BREAK, "break")
    progWideCut(p, _eventX, _eventY, _eventZ)
    var spark = progSkillLvl(p, "m_spark")
    if (spark > 0) {
        particleSpawn("minecraft:enchant", _eventX + 0.5, _eventY + 0.5, _eventZ + 0.5, spark * 3, 0.2, 0.2, 0.2, 0.02)
    }
}

on placeBlock() -> progPlace {
    val p = _eventPlayer
    if (p == null) { return }
    if (!progIsPlayer(p)) { return }
    progInit(p)
    progAddXp(p, PROG_XP_PLACE, "place")
    progApplyStats(p)
}

on action("craft") -> progCraft {
    val p = _eventPlayer
    if (p == null) { return }
    if (!progIsPlayer(p)) { return }
    progInit(p)
    progAddXp(p, PROG_XP_CRAFT, "craft")
}

on kill() -> progKill {
    val killer = _eventKiller
    if (killer == null) { return }
    if (!progIsPlayer(killer)) { return }
    progInit(killer)
    progAddXp(killer, PROG_XP_KILL, "kill")
    progOnKillSkills(killer, _eventEntity)
}

on keybind("P") -> progKeyMenu {
    val p = _eventPlayer
    if (p == null) { return }
    progOpenMenu(p)
}

on keybind("space") -> progAirJumpKey {
    val p = _eventPlayer
    if (p == null) { return }
    if (!progIsPlayer(p)) { return }
    progInit(p)
    progTryAirJump(p)
}

on keybind("shift") -> progDashKey {
    val p = _eventPlayer
    if (p == null) { return }
    if (!progIsPlayer(p)) { return }
    progInit(p)
    progHandleDashKey(p)
}

on keybind("N") -> progToggleSpeedKey {
    val p = _eventPlayer
    if (p == null) { return }
    if (!progIsPlayer(p)) { return }
    progToggleSpeed(p)
}

every(0.05) -> progFallTick {
    val players = getPlayers()
    var pi = 0
    while (pi < listSize(players)) {
        var p = players[pi]
        if (progIsPlayer(p)) {
            progFallSafeTick(p)
        }
        pi = pi + 1
    }
}

every(0.2) -> progWorldTick {
    val players = getPlayers()
    var pi = 0
    while (pi < listSize(players)) {
        var p = players[pi]
        if (progIsPlayer(p)) {
            progInit(p)
            progApplyStats(p)
            var tap = p.savedData["prog_dash_tap"]
            if (tap == null) { tap = 0 }
            if (tap > 0) {
                p.savedData["prog_dash_tap"] = tap - 1
            }
            if (p.onGround) {
                progOnLand(p)
                progResetAirJumps(p)
            }
            var cd = p.savedData["prog_dash_cd"]
            if (cd == null) { cd = 0 }
            if (cd > 0) {
                p.savedData["prog_dash_cd"] = cd - 0.2
            }
        }
        pi = pi + 1
    }
}

on uiClick() -> progUiClick {
    val p = _eventPlayer
    val btn = _eventWidget
    if (p == null) { return }
    if (btn == null) { return }

    if (btn == "pm_close") {
        uiClose(p)
        playSound(p, "minecraft:ui.button.click", 1.0, 1.0)
        return
    }

    if (btn == "stat_dmg") { progTryUpgradeStat(p, "stat_dmg") }
    if (btn == "stat_spd") { progTryUpgradeStat(p, "stat_spd") }
    if (btn == "stat_dig") { progTryUpgradeStat(p, "stat_dig") }

    var si = 0
    while (si < listSize(PROG_SKILL_IDS)) {
        var sid = PROG_SKILL_IDS[si]
        if (btn == "skill_" + sid) {
            progTryUpgradeSkill(p, sid)
        }
        si = si + 1
    }
}

# ──── Команды (нужен запущенный скрипт: /spraute run progression) ────

fun progCmdAmount(args, defVal) {
    if (args == null) { return defVal }
    if (listSize(args) < 1) { return defVal }
    var v = args[0]
    if (v == null) { return defVal }
    return v
}

create command progxp {
    val p = _eventPlayer
    val args = _eventArgs
    if (p == null) { return }
    progInit(p)
    var amt = progCmdAmount(args, 100)
    if (amt < 1) { amt = 1 }
    progAddXp(p, amt, "cmd")
    chat(p, "§a+§e" + amt + " §7опыта прокачки")
}

create command progpoints {
    val p = _eventPlayer
    val args = _eventArgs
    if (p == null) { return }
    progInit(p)
    var amt = progCmdAmount(args, 1)
    if (amt < 1) { amt = 1 }
    if (p.savedData["prog_points"] == null) { p.savedData["prog_points"] = 0 }
    p.savedData["prog_points"] = p.savedData["prog_points"] + amt
    chat(p, "§a+§e" + amt + " §7очк. (всего: " + p.savedData["prog_points"] + ")")
}
