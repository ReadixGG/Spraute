# Math Quiz Minigame
val spawn = findSafeBlock("player", 5, 3)
if (spawn == null) {
    chat("§c[Math Quiz] Не нашёл безопасное место рядом с игроком!")
} else {
    val sx = listGet(spawn, 0)
    val sy = listGet(spawn, 1)
    val sz = listGet(spawn, 2)

    create npc math_master {
        name = "§eMath Master"
        pos = sx, sy, sz
        showName = true
        model = "geo/defolt.geo.json"
        texture = "textures/entity/defolt.png"
        animation = "animations/npc_classic.animation.json"
    }

    chat("§a[Math Quiz] Мастер математики появился рядом с тобой! Нажми ПКМ.")

    val quiz_running = false

    on interact(math_master) -> start_quiz {
        if (quiz_running) { return null }
        quiz_running = true

        async {
            val p = _eventPlayer
            math_master.alwaysLookAt(p)
            math_master.playOnce("hello")
            say(math_master, "Привет, " + p.name + "! Реши 3 примера!")

            val score = 0

            for (i in range(1, 4)) {
                val a = random(1, 20)
                val b = random(1, 20)
                val answer = a + b

                val fake1 = answer + random(1, 5)
                val fake2 = answer - random(1, 5)

                create ui math_ui {
                    size = ["200", "100"]
                    background = "#DD222222"
                    canClose = false

                    text("question", a + " + " + b + " = ?") {
                        pos = ["50%", "20"]
                        anchor = "center"
                        color = "#FFFFFF"
                        scale = 1.5
                    }

                    val r = random(1, 3)
                    if (r == 1) {
                        button("btn_ans", answer + "") { pos = ["10", "50"]; size = ["50", "20"] }
                        button("btn_fake1", fake1 + "") { pos = ["75", "50"]; size = ["50", "20"] }
                        button("btn_fake2", fake2 + "") { pos = ["140", "50"]; size = ["50", "20"] }
                    } else if (r == 2) {
                        button("btn_fake1", fake1 + "") { pos = ["10", "50"]; size = ["50", "20"] }
                        button("btn_ans", answer + "") { pos = ["75", "50"]; size = ["50", "20"] }
                        button("btn_fake2", fake2 + "") { pos = ["140", "50"]; size = ["50", "20"] }
                    } else {
                        button("btn_fake1", fake1 + "") { pos = ["10", "50"]; size = ["50", "20"] }
                        button("btn_fake2", fake2 + "") { pos = ["75", "50"]; size = ["50", "20"] }
                        button("btn_ans", answer + "") { pos = ["140", "50"]; size = ["50", "20"] }
                    }
                }

                uiOpen(p, math_ui)
                val clicked = await uiClick(p)
                uiClose(p)

                if (clicked == "btn_ans") {
                    score = score + 1
                    math_master.playOnce("yes")
                    say(math_master, "Правильно!")
                    playSound(p, "minecraft:entity.player.levelup", 1.0, 2.0)
                } else {
                    math_master.playOnce("sad")
                    say(math_master, "Неверно! Правильный ответ: " + answer)
                    playSound(p, "minecraft:block.note_block.bass", 1.0, 0.5)
                }
                await time(1)
            }

            say(math_master, "Твой счет: " + score + " из 3!")
            if (score == 3) {
                math_master.playOnce("laughter")
                say(math_master, "Ты гений!")
                spawnOrb("minecraft:textures/item/diamond.png", 5, math_master.x, math_master.y + 1, math_master.z)
            }
            quiz_running = false
        }
    }
}
