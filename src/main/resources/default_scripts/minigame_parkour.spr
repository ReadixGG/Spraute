# Parkour Minigame
val spawn = findSafeBlock("player", 5, 3)
if (spawn == null) {
    chat("§c[Parkour] Не нашёл безопасное место рядом с игроком!")
} else {
    val px = listGet(spawn, 0)
    val py = listGet(spawn, 1)
    val pz = listGet(spawn, 2)

    create npc parkour_master {
        name = "§aПаркур Мастер"
        pos = px - 2, py, pz - 2
        showName = true
        model = "geo/defolt.geo.json"
        texture = "textures/entity/defolt.png"
        animation = "animations/npc_classic.animation.json"
    }

    chat("§a[Parkour] Паркур мастер появился рядом с тобой! Нажми ПКМ.")

    val parkour_active = false
    val current_player = null
    val finish_x = px + 9
    val finish_y = py + 3
    val finish_z = pz + 5

    fun build_parkour() {
        setBlock(px, py, pz, "minecraft:emerald_block")
        setBlock(px + 3, py + 1, pz, "minecraft:gold_block")
        setBlock(px + 6, py + 2, pz + 2, "minecraft:iron_block")
        setBlock(finish_x, finish_y, finish_z, "minecraft:diamond_block")
    }

    build_parkour()

    on interact(parkour_master) -> start_parkour {
        val p = _eventPlayer
        if (parkour_active) {
            say(parkour_master, "Кто-то уже проходит паркур!")
            return null
        }
        parkour_master.alwaysLookAt(p)
        parkour_master.playOnce("hello")
        say(parkour_master, "Добеги до финишного блока с алмазами!")
        parkour_active = true
        current_player = p
        execute("tp @s " + px + " " + (py + 1) + " " + pz, p)
        playSound(p, "minecraft:block.note_block.pling", 1.0, 1.0)
        
        async "parkour_finish" {
            # Ждем пока игрок не окажется в радиусе 1.5 блоков от финиша
            await position(p, finish_x + 0.5, finish_y + 1, finish_z + 0.5, 1.5)
            
            if (parkour_active && p == current_player) {
                parkour_active = false
                current_player = null
                
                parkour_master.playOnce("laughter")
                say(parkour_master, "Победа! Ты прошёл паркур!")
                playSound(p, "minecraft:ui.toast.challenge_complete", 1.0, 1.0)
                
                particleSpawn("minecraft:firework", finish_x + 0.5, finish_y + 1.5, finish_z + 0.5, 0.5, 0.5, 0.5, 0.1, 100)
                particleSpawn("minecraft:totem_of_undying", finish_x + 0.5, finish_y + 1.5, finish_z + 0.5, 0.5, 0.5, 0.5, 0.5, 50)
                
                spawnOrb("minecraft:textures/item/diamond.png", 10, finish_x, finish_y + 1, finish_z)
                
                execute("tp @s " + parkour_master.x + " " + (parkour_master.y + 1) + " " + parkour_master.z, p)
                
                await orbPickup(p, 10, "minecraft:textures/item/diamond.png")
                giveItem(p, "minecraft:diamond", 1)
            }
        }
        
        async "parkour_timer" {
            var time_taken = 0
            while (parkour_active) {
                await time(1)
                time_taken = time_taken + 1
                if (time_taken > 30) {
                    parkour_master.playOnce("sad")
                    say(parkour_master, "Время вышло!")
                    parkour_active = false
                    current_player = null
                    execute("tp @s " + parkour_master.x + " " + (parkour_master.y + 1) + " " + parkour_master.z, p)
                    stopTask("parkour_finish")
                }
            }
        }
    }
}
