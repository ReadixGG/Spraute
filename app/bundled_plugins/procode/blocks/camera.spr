#\ if runMode == "await" and afterEnd == "stay" and lookMode == "lookAt":
#\   template: await cameraRoute({player}, "{route}", {lockMovement}, "{hideGui}", 0, {totalTime}, "stay", "lookAt", {lookX}, {lookY}, {lookZ}, "interp", "{interp}", "transition", {transition}, "lockBlocks", {lockBlocks})
