#\ block: set_camera
#\ category: Камера
#\ color: #8b5cf6
#\ shape: statement
#\
#\ row: "камера для" [who: dropdown(кликнувший: event, первый: first, указать: custom)]
#\ if who == "custom":
#\   input: player (type: value)
#\ row: [runMode: dropdown(запустить: play, ждать конца: await)]
#\ row: [mode: dropdown(позиция: position, с удержанием: hold, смотреть на точку: lookCoords, смотреть на цель: lookEntity)]
#\ if mode == "position" or mode == "hold":
#\   row: "позиция" (x: number: 0) (y: number: 70) (z: number: 0)
#\   row: "yaw" (yaw: number: 0) "pitch" (pitch: number: 0) "плавно" (smooth: number: 0.5) "сек"
#\ if mode == "hold":
#\   row: "удержать" (hold: number: 3) "сек"
#\ if mode == "lookCoords" or mode == "lookEntity":
#\   row: "позиция камеры" (cx: number: 0) (cy: number: 80) (cz: number: 0)
#\ if mode == "lookCoords":
#\   row: "смотрит на" (lx: number: 0) (ly: number: 64) (lz: number: 0)
#\   row: "удержать" (hold: number: 0) "сек" "плавно" (smooth: number: 0.8)
#\ if mode == "lookEntity":
#\   row: "смотрит на" [target: dropdown(НИП: npc_ref, игрока: player, моба: mob)]
#\   if target == "npc_ref":
#\     row: [npc: dropdown_npc]
#\   row: "удержать" (hold: number: 0) "сек" "плавно" (smooth: number: 0.8) "следить" [track: checkbox]
#\ row: "блокировать ходьбу" [lockMovement: checkbox(true)]
#\ row: "скрыть GUI" [hideGui: dropdown(майнкрафт: minecraft, не скрывать: none, всё: all)]
#\
#\ if mode == "position" and runMode == "play" and who == "event":
#\   template: setCamera(_eventPlayer, {x}, {y}, {z}, {yaw}, {pitch}, 0, {smooth}, {lockMovement}, "{hideGui}")
#\ if mode == "position" and runMode == "play" and who == "first":
#\   template: setCamera(getFirstPlayer(), {x}, {y}, {z}, {yaw}, {pitch}, 0, {smooth}, {lockMovement}, "{hideGui}")
#\ if mode == "position" and runMode == "play" and who == "custom":
#\   template: setCamera({player}, {x}, {y}, {z}, {yaw}, {pitch}, 0, {smooth}, {lockMovement}, "{hideGui}")
#\ if mode == "position" and runMode == "await" and who == "event":
#\   template: await time(setCamera(_eventPlayer, {x}, {y}, {z}, {yaw}, {pitch}, 0, {smooth}, {lockMovement}, "{hideGui}"))
#\ if mode == "position" and runMode == "await" and who == "first":
#\   template: await time(setCamera(getFirstPlayer(), {x}, {y}, {z}, {yaw}, {pitch}, 0, {smooth}, {lockMovement}, "{hideGui}"))
#\ if mode == "position" and runMode == "await" and who == "custom":
#\   template: await time(setCamera({player}, {x}, {y}, {z}, {yaw}, {pitch}, 0, {smooth}, {lockMovement}, "{hideGui}"))
#\
#\ if mode == "hold" and runMode == "play" and who == "event":
#\   template: setCamera(_eventPlayer, {x}, {y}, {z}, {yaw}, {pitch}, {hold}, {smooth}, {lockMovement}, "{hideGui}")
#\ if mode == "hold" and runMode == "play" and who == "first":
#\   template: setCamera(getFirstPlayer(), {x}, {y}, {z}, {yaw}, {pitch}, {hold}, {smooth}, {lockMovement}, "{hideGui}")
#\ if mode == "hold" and runMode == "play" and who == "custom":
#\   template: setCamera({player}, {x}, {y}, {z}, {yaw}, {pitch}, {hold}, {smooth}, {lockMovement}, "{hideGui}")
#\ if mode == "hold" and runMode == "await" and who == "event":
#\   template: await time(setCamera(_eventPlayer, {x}, {y}, {z}, {yaw}, {pitch}, {hold}, {smooth}, {lockMovement}, "{hideGui}"))
#\ if mode == "hold" and runMode == "await" and who == "first":
#\   template: await time(setCamera(getFirstPlayer(), {x}, {y}, {z}, {yaw}, {pitch}, {hold}, {smooth}, {lockMovement}, "{hideGui}"))
#\ if mode == "hold" and runMode == "await" and who == "custom":
#\   template: await time(setCamera({player}, {x}, {y}, {z}, {yaw}, {pitch}, {hold}, {smooth}, {lockMovement}, "{hideGui}"))
#\
#\ if mode == "lookCoords" and runMode == "play" and who == "event":
#\   template: setCameraLookAt(_eventPlayer, {cx}, {cy}, {cz}, {lx}, {ly}, {lz}, {hold}, {smooth}, false, {lockMovement}, "{hideGui}")
#\ if mode == "lookCoords" and runMode == "play" and who == "first":
#\   template: setCameraLookAt(getFirstPlayer(), {cx}, {cy}, {cz}, {lx}, {ly}, {lz}, {hold}, {smooth}, false, {lockMovement}, "{hideGui}")
#\ if mode == "lookCoords" and runMode == "play" and who == "custom":
#\   template: setCameraLookAt({player}, {cx}, {cy}, {cz}, {lx}, {ly}, {lz}, {hold}, {smooth}, false, {lockMovement}, "{hideGui}")
#\ if mode == "lookCoords" and runMode == "await" and who == "event":
#\   template: await time(setCameraLookAt(_eventPlayer, {cx}, {cy}, {cz}, {lx}, {ly}, {lz}, {hold}, {smooth}, false, {lockMovement}, "{hideGui}"))
#\ if mode == "lookCoords" and runMode == "await" and who == "first":
#\   template: await time(setCameraLookAt(getFirstPlayer(), {cx}, {cy}, {cz}, {lx}, {ly}, {lz}, {hold}, {smooth}, false, {lockMovement}, "{hideGui}"))
#\ if mode == "lookCoords" and runMode == "await" and who == "custom":
#\   template: await time(setCameraLookAt({player}, {cx}, {cy}, {cz}, {lx}, {ly}, {lz}, {hold}, {smooth}, false, {lockMovement}, "{hideGui}"))
#\
#\ if mode == "lookEntity" and target == "npc_ref" and runMode == "play" and who == "event":
#\   template: setCameraLookAt(_eventPlayer, {cx}, {cy}, {cz}, {npc}, {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}")
#\ if mode == "lookEntity" and target == "npc_ref" and runMode == "play" and who == "first":
#\   template: setCameraLookAt(getFirstPlayer(), {cx}, {cy}, {cz}, {npc}, {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}")
#\ if mode == "lookEntity" and target == "npc_ref" and runMode == "play" and who == "custom":
#\   template: setCameraLookAt({player}, {cx}, {cy}, {cz}, {npc}, {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}")
#\ if mode == "lookEntity" and target == "npc_ref" and runMode == "await" and who == "event":
#\   template: await time(setCameraLookAt(_eventPlayer, {cx}, {cy}, {cz}, {npc}, {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}"))
#\ if mode == "lookEntity" and target == "npc_ref" and runMode == "await" and who == "first":
#\   template: await time(setCameraLookAt(getFirstPlayer(), {cx}, {cy}, {cz}, {npc}, {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}"))
#\ if mode == "lookEntity" and target == "npc_ref" and runMode == "await" and who == "custom":
#\   template: await time(setCameraLookAt({player}, {cx}, {cy}, {cz}, {npc}, {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}"))
#\ if mode == "lookEntity" and target != "npc_ref" and runMode == "play" and who == "event":
#\   template: setCameraLookAt(_eventPlayer, {cx}, {cy}, {cz}, "{target}", {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}")
#\ if mode == "lookEntity" and target != "npc_ref" and runMode == "play" and who == "first":
#\   template: setCameraLookAt(getFirstPlayer(), {cx}, {cy}, {cz}, "{target}", {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}")
#\ if mode == "lookEntity" and target != "npc_ref" and runMode == "play" and who == "custom":
#\   template: setCameraLookAt({player}, {cx}, {cy}, {cz}, "{target}", {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}")
#\ if mode == "lookEntity" and target != "npc_ref" and runMode == "await" and who == "event":
#\   template: await time(setCameraLookAt(_eventPlayer, {cx}, {cy}, {cz}, "{target}", {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}"))
#\ if mode == "lookEntity" and target != "npc_ref" and runMode == "await" and who == "first":
#\   template: await time(setCameraLookAt(getFirstPlayer(), {cx}, {cy}, {cz}, "{target}", {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}"))
#\ if mode == "lookEntity" and target != "npc_ref" and runMode == "await" and who == "custom":
#\   template: await time(setCameraLookAt({player}, {cx}, {cy}, {cz}, "{target}", {hold}, {smooth}, {track}, {lockMovement}, "{hideGui}"))

