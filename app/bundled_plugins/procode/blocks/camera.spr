#\ code:   call = 'animateCamera(' + player + ', ' + (_getVal('x')||'0') + ', ' + (_getVal('y')||'70') + ', ' + (_getVal('z')||'0') + ', ' + (_getVal('yaw')||'0') + ', ' + (_getVal('pitch')||'0') + ', ' + smooth + ', ' + lock + ', "' + hide + '", ' + lockBlocks + ')';
#\ code: } else {
#\ code:   var target = String(_getVal('target') || 'coords');
#\ code:   var track = String(_getVal('track') || 'FALSE').toUpperCase() === 'TRUE' ? 'true' : 'false';
#\ code:   var lookTarget = (target === 'coords')
#\ code:     ? ((_getVal('lx')||'0') + ', ' + (_getVal('ly')||'64') + ', ' + (_getVal('lz')||'0'))
#\ code:     : (target === 'npc_ref' ? (_getVal('npc') || '""') : ('"' + target + '"'));
#\ code:   call = 'animateCameraLookAt(' + player + ', ' + (_getVal('x')||'0') + ', ' + (_getVal('y')||'70') + ', ' + (_getVal('z')||'0') + ', ' + lookTarget + ', ' + smooth + ', ' + track + ', ' + lock + ', "' + hide + '", ' + lockBlocks + ')';
#\ code: }
#\ code: return (runMode === 'await' ? ('await time(' + call + ')') : call) + '\n';

#\ block: camera_lookat
#\ category: Камера
#\ color: #8b5cf6
#\ shape: statement
#\
#\ row: "катсцена — взгляд камеры" input: player (type: value)
#\ row: "смотрит на" [target: dropdown(точку: coords, НИП: npc_ref, игрока: player, моба: mob)]
#\ if target == "coords":
#\   row: (lx: number: 0) (ly: number: 64) (lz: number: 0)
#\ if target == "npc_ref":
#\   row: [npc: dropdown_npc]
#\ row: "следить" [track: checkbox]
#\ row: [ease: dropdown(резко: snap, плавно: smooth)]
#\ if ease == "smooth":
#\   row: "подлёт за" (smooth: number: 0.8) "сек"
#\
#\ code: var player = String(_getVal('player') || '_eventPlayer').trim() || '_eventPlayer';
#\ code: var target = String(_getVal('target') || 'coords');
#\ code: var track = String(_getVal('track') || 'FALSE').toUpperCase() === 'TRUE' ? 'true' : 'false';
#\ code: var ease = String(_getVal('ease') || 'smooth');
#\ code: var smooth = (ease === 'snap') ? '0' : (String(_getVal('smooth') || '0.8').trim() || '0.8');
#\ code: var look;
#\ code: if (target === 'coords') look = (_getVal('lx')||'0') + ', ' + (_getVal('ly')||'64') + ', ' + (_getVal('lz')||'0');
#\ code: else if (target === 'npc_ref') look = _getVal('npc') || '""';
#\ code: else look = '"' + target + '"';
#\ code: return 'cameraLookAt(' + player + ', ' + look + ', ' + track + ', ' + smooth + ')\n';

#\ block: stop_camera
#\ category: Камера
#\ color: #8b5cf6
#\ shape: statement
#\
#\ row: "катсцена — остановить" input: player (type: value)
#\ row: [mode: dropdown(вернуть плавно: stopSmooth, вернуть: stop, отключить мгновенно: reset)]
#\ if mode == "stopSmooth":
#\   row: [runMode: dropdown(запустить: play, ждать конца: await)]
#\   row: "плавно за" (smooth: number: 0.8) "сек"
#\ if mode == "stop":
#\   template: stopCamera({player})
#\ if mode == "stopSmooth" and runMode == "play":
#\   template: stopCamera({player}, {smooth})
#\ if mode == "stopSmooth" and runMode == "await":
#\   template: await time(stopCamera({player}, {smooth}))
#\ if mode == "reset":
#\   template: resetCamera({player})

#\ block: camera_route_at_point
#\ category: Камера
#\ color: #8b5cf6
#\ shape: statement
#\
#\ row: "ждать точки" (point: number: 2) "маршрута" (route: text: intro)
#\ row: [stopMode: dropdown(продолжить: continue, остановить мгновенно: stop, вернуть игроку: return)]
#\ if stopMode != "continue":
#\   row: "для" input: player (type: value)
#\ if stopMode == "return":
#\   row: "плавно за" (smooth: number: 0.8) "сек"
#\
#\ if stopMode == "continue":
#\   template: await time(cameraWaypointTime("{route}", {point}))
#\ if stopMode == "stop":
#\   template: await time(cameraRouteStopAtPoint({player}, "{route}", {point}, 0))
#\ if stopMode == "return":
#\   template: await time(cameraRouteStopAtPoint({player}, "{route}", {point}, {smooth}))

#\ block: play_camera_route
#\ category: Камера
#\ color: #8b5cf6
#\ shape: statement
#\
#\ row: "катсцена — маршрут из файла" input: player (type: value)
