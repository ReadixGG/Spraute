#\ block: set_camera
#\ category: Камера
#\ color: #8b5cf6
#\ shape: statement
#\
#\ row: "катсцена — поставить камеру" input: player (type: value)
#\ row: [runMode: dropdown(запустить: play, ждать конца: await)]
#\ row: [mode: dropdown(позиция: position, с удержанием: hold, смотреть на точку: lookCoords, смотреть на цель: lookEntity)]
#\ row: [ease: dropdown(резко: snap, плавно: smooth)]
#\ if mode == "position" or mode == "hold":
#\   row: "позиция" (x: number: 0) (y: number: 70) (z: number: 0)
#\   row: "рысканье" (yaw: number: 0) "тангаж" (pitch: number: 0)
#\   if ease == "smooth":
#\     row: "подлёт за" (smooth: number: 0.5) "сек"
#\ if mode == "hold":
#\   row: "удержать" (hold: number: 3) "сек"
#\ if mode == "lookCoords" or mode == "lookEntity":
#\   row: "позиция камеры" (cx: number: 0) (cy: number: 80) (cz: number: 0)
#\ if mode == "lookCoords":
#\   row: "смотрит на" (lx: number: 0) (ly: number: 64) (lz: number: 0)
#\   row: "удержать" (hold: number: 0) "сек"
#\   if ease == "smooth":
#\     row: "подлёт за" (smooth: number: 0.8) "сек"
#\ if mode == "lookEntity":
#\   row: "смотрит на" [target: dropdown(НИП: npc_ref, игрока: player, моба: mob)]
#\   if target == "npc_ref":
#\     row: [npc: dropdown_npc]
#\   row: "удержать" (hold: number: 0) "сек" "следить" [track: checkbox]
#\   if ease == "smooth":
#\     row: "подлёт за" (smooth: number: 0.8) "сек"
#\ row: "блокировать ходьбу" [lockMovement: checkbox(true)]
#\ row: "блокировать блоки" [lockBlocks: checkbox(true)]
#\ row: "скрыть GUI" [hideGui: dropdown(майнкрафт: minecraft, не скрывать: none, всё: all)]
#\
#\ code: var player = String(_getVal('player') || '_eventPlayer').trim() || '_eventPlayer';
#\ code: var mode = String(_getVal('mode') || 'position');
#\ code: var runMode = String(_getVal('runMode') || 'play');
#\ code: var ease = String(_getVal('ease') || 'smooth');
#\ code: var smooth = (ease === 'snap') ? '0' : (String(_getVal('smooth') || '0.5').trim() || '0.5');
#\ code: var hold = String(_getVal('hold') || (mode === 'hold' ? '3' : '0')).trim() || '0';
#\ code: var lock = String(_getVal('lockMovement') || 'TRUE').toUpperCase() === 'TRUE' ? 'true' : 'false';
#\ code: var lockBlocks = String(_getVal('lockBlocks') || 'TRUE').toUpperCase() === 'TRUE' ? 'true' : 'false';
#\ code: var hide = String(_getVal('hideGui') || 'minecraft').trim() || 'minecraft';
#\ code: var call = '';
#\ code: if (mode === 'position' || mode === 'hold') {
#\ code:   var h = (mode === 'hold') ? hold : '0';
#\ code:   call = 'setCamera(' + player + ', ' + (_getVal('x')||'0') + ', ' + (_getVal('y')||'70') + ', ' + (_getVal('z')||'0') + ', ' + (_getVal('yaw')||'0') + ', ' + (_getVal('pitch')||'0') + ', ' + h + ', ' + smooth + ', ' + lock + ', "' + hide + '", ' + lockBlocks + ')';
#\ code: } else if (mode === 'lookCoords') {
#\ code:   call = 'setCameraLookAt(' + player + ', ' + (_getVal('cx')||'0') + ', ' + (_getVal('cy')||'80') + ', ' + (_getVal('cz')||'0') + ', ' + (_getVal('lx')||'0') + ', ' + (_getVal('ly')||'64') + ', ' + (_getVal('lz')||'0') + ', ' + hold + ', ' + smooth + ', false, ' + lock + ', "' + hide + '", ' + lockBlocks + ')';
#\ code: } else {
#\ code:   var target = String(_getVal('target') || 'npc_ref');
#\ code:   var track = String(_getVal('track') || 'FALSE').toUpperCase() === 'TRUE' ? 'true' : 'false';
#\ code:   var lookTarget = (target === 'npc_ref') ? (_getVal('npc') || '""') : ('"' + target + '"');
#\ code:   call = 'setCameraLookAt(' + player + ', ' + (_getVal('cx')||'0') + ', ' + (_getVal('cy')||'80') + ', ' + (_getVal('cz')||'0') + ', ' + lookTarget + ', ' + hold + ', ' + smooth + ', ' + track + ', ' + lock + ', "' + hide + '", ' + lockBlocks + ')';
#\ code: }
#\ code: return (runMode === 'await' ? ('await time(' + call + ')') : call) + '\n';

#\ block: animate_camera
#\ category: Камера
#\ color: #8b5cf6
#\ shape: statement
#\
#\ row: "катсцена — анимация камеры" input: player (type: value)
