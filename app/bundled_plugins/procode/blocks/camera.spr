#\   row: "смотреть на" (lookX: number: 0) (lookY: number: 64) (lookZ: number: 0)
#\ row: "интерполяция" [interp: dropdown(из файла: route, по линиям: linear, плавная кривая: smooth, плавная камера: smooth_camera)]
#\ row: "переход за" (transition: number: 0) "сек (0 = мгновенно)"
