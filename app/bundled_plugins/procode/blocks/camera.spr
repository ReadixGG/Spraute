#\ row: [runMode: dropdown(запустить: play, ждать окончания: await)]
#\ row: "пролёт за" (totalTime: number: 0) "сек" "0 = из файла"
#\ row: [afterEnd: dropdown(вернуться к игроку: return, остановиться: stay)]
#\ if afterEnd == "return":
#\   row: "возврат за" (returnSmooth: number: 0.8) "сек"
#\ row: "блокировать ходьбу" [lockMovement: checkbox(true)]
#\ row: "блокировать блоки" [lockBlocks: checkbox(true)]
#\ row: "скрыть GUI" [hideGui: dropdown(майнкрафт: minecraft, не скрывать: none, всё: all)]
#\ row: [lookMode: dropdown(из маршрута: route, перезаписать взгляд: lookAt)]
