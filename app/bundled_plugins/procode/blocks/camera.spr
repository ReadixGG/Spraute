#\ block: play_camera_route
#\ category: Камера
#\ color: #8b5cf6
#\ shape: statement
#\
#\ row: "маршрут камеры для" [who: dropdown(кликнувший: event, первый: first, указать: custom)]
#\ if who == "custom":
#\   input: player (type: value)
#\ row: "файл" (route: text: intro)
#\ row: [runMode: dropdown(запустить: play, ждать окончания: await)]
#\ row: "пролёт за" (totalTime: number: 0) "сек" "0 = из файла"
#\ row: [afterEnd: dropdown(вернуться к игроку: return, остановиться: stay)]
#\ if afterEnd == "return":
#\   row: "возврат за" (returnSmooth: number: 0.8) "сек"
#\ row: "блокировать ходьбу" [lockMovement: checkbox(true)]
#\ row: "скрыть GUI" [hideGui: dropdown(майнкрафт: minecraft, не скрывать: none, всё: all)]
#\ row: [lookMode: dropdown(из маршрута: route, перезаписать взгляд: lookAt)]
#\ if lookMode == "lookAt":
#\   row: "смотреть на" (lookX: number: 0) (lookY: number: 64) (lookZ: number: 0)
#\ row: "интерполяция" [interp: dropdown(из файла: route, по линиям: linear, плавная кривая: smooth, плавная камера: smooth_camera)]
#\ row: "переход за" (transition: number: 0) "сек (0 = мгновенно)"
#\
#\ if runMode == "play" and afterEnd == "return" and lookMode == "route" and who == "event":
#\   template: playCameraRoute(_eventPlayer, "{route}", {lockMovement}, "{hideGui}", {returnSmooth}, {totalTime}, "return", "interp", "{interp}", "transition", {transition})
#\ if runMode == "play" and afterEnd == "return" and lookMode == "route" and who == "first":
#\   template: playCameraRoute(getFirstPlayer(), "{route}", {lockMovement}, "{hideGui}", {returnSmooth}, {totalTime}, "return", "interp", "{interp}", "transition", {transition})
#\ if runMode == "play" and afterEnd == "return" and lookMode == "route" and who == "custom":
#\   template: playCameraRoute({player}, "{route}", {lockMovement}, "{hideGui}", {returnSmooth}, {totalTime}, "return", "interp", "{interp}", "transition", {transition})
#\ if runMode == "play" and afterEnd == "return" and lookMode == "lookAt" and who == "event":
#\   template: playCameraRoute(_eventPlayer, "{route}", {lockMovement}, "{hideGui}", {returnSmooth}, {totalTime}, "return", "lookAt", {lookX}, {lookY}, {lookZ}, "interp", "{interp}", "transition", {transition})
