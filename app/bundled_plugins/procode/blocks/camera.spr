#\ if runMode == "play" and afterEnd == "stay" and lookMode == "route":
#\   template: playCameraRoute({player}, "{route}", {lockMovement}, "{hideGui}", 0, {totalTime}, "stay", "interp", "{interp}", "transition", {transition}, "lockBlocks", {lockBlocks})
