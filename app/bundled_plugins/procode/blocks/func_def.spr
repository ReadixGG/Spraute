#\ code: return (function(){ var n=String(_getVal("name")||"myFunc").trim()||"myFunc"; var p=[], vs=["p1","p2","p3","p4","p5","p6","p7","p8"]; for(var i=0;i<8;i++){ var v=String(_getVal(vs[i])||"").trim(); if(v) p.push(v); } var body=_getVal("DO")||""; return "fun "+n+"("+p.join(", ")+") {\n"+body+"}\n"; })();
