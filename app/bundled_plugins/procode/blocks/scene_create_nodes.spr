#\ row: "форма" [shape: dropdown(точка: point, линия: line, куб: box, шар: sphere, оболочка: shell, круг: circle, диск: disc, конус: cone, цилиндр: cylinder, спираль: spiral)]
#\ row: "частиц/сек" (rate: number: 20) "burst" (count: number: 12) "лимит" (maxParticles: number: 2048)
