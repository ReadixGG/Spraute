#\
#\ row: "силы частиц" (node: value)
#\ row: "гравитация" (gx: number: 0) (gy: number: -0.04) (gz: number: 0) "drag" (drag: number: 0)
#\ row: "turbulence" (noise: number: 0) "частота" (frequency: number: 1) "vortex" (vortex: number: 0)
#\ template: {node}.particles.motion.gravityX = {gx}\n{node}.particles.motion.gravityY = {gy}\n{node}.particles.motion.gravityZ = {gz}\n{node}.particles.motion.drag = {drag}\n{node}.particles.motion.noiseStrength = {noise}\n{node}.particles.motion.noiseFrequency = {frequency}\n{node}.particles.motion.vortexStrength = {vortex}

#\ block: particle_system_modules
#\ category: Частицы
#\ color: #f472b6
#\ shape: statement
#\
#\ row: "модули частиц" (node: value)
#\ row: "collision" [collision: dropdown(выкл: false, вкл: true)] "убить при ударе" [kill: dropdown(нет: false, да: true)] "bounce" (bounce: number: 0.35)
#\ row: "trail" [trail: dropdown(выкл: false, вкл: true)] "gameplay proxy" [gameplay: dropdown(выкл: false, вкл: true)]
#\ template: {node}.particles.collision.enabled = {collision}\n{node}.particles.collision.killOnCollision = {kill}\n{node}.particles.collision.bounce = {bounce}\n{node}.particles.trail.enabled = {trail}\n{node}.particles.gameplay.enabled = {gameplay}

