#\ template: {node}.particles.renderer.texture = "{texture}"\n{node}.particles.renderer.mode = "{mode}"\n{node}.particles.renderer.blend = "{blend}"

#\ block: particle_system_emission
#\ category: Частицы
#\ color: #f472b6
#\ shape: statement
#\
#\ row: "эмиссия" (node: value) "частиц/сек" (rate: number: 20)
#\ row: "длительность" (duration: number: 5) "лимит" (max: number: 2048) "цикл" [loop: dropdown(да: true, нет: false)]
#\ template: {node}.particles.emission.rate = {rate}\n{node}.particles.emission.duration = {duration}\n{node}.particles.emission.maxParticles = {max}\n{node}.particles.emission.loop = {loop}

#\ block: particle_system_shape
#\ category: Частицы
#\ color: #f472b6
#\ shape: statement
#\
#\ row: "форма Particle System" (node: value) [shape: dropdown(точка: point, линия: line, куб: box, шар: sphere, оболочка: shell, круг: circle, диск: disc, конус: cone, цилиндр: cylinder, спираль: spiral)]
#\ row: "направление" (x: number: 0) (y: number: 1) (z: number: 0) "угол°" (angle: number: 25)
#\ row: "радиус" (radius: number: 1) "высота" (height: number: 2)
#\ template: {node}.particles.shape.type = "{shape}"\n{node}.particles.shape.dirX = {x}\n{node}.particles.shape.dirY = {y}\n{node}.particles.shape.dirZ = {z}\n{node}.particles.shape.angle = {angle}\n{node}.particles.shape.radius = {radius}\n{node}.particles.shape.height = {height}

#\ block: particle_system_initial
#\ category: Частицы
#\ color: #f472b6
#\ shape: statement
#\
#\ row: "старт частиц" (node: value)
#\ row: "жизнь min/max" (lifeMin: number: 1) (lifeMax: number: 2) "скорость min/max" (speedMin: number: 0.05) (speedMax: number: 0.2)
#\ row: "размер min/max" (sizeMin: number: 0.25) (sizeMax: number: 0.5)
#\ template: {node}.particles.initial.lifetimeMin = {lifeMin}\n{node}.particles.initial.lifetimeMax = {lifeMax}\n{node}.particles.initial.speedMin = {speedMin}\n{node}.particles.initial.speedMax = {speedMax}\n{node}.particles.initial.sizeMin = {sizeMin}\n{node}.particles.initial.sizeMax = {sizeMax}

#\ block: particle_system_over_lifetime
#\ category: Частицы
#\ color: #f472b6
#\ shape: statement
#\
#\ row: "за время жизни" (node: value) "размер" (sizeStart: number: 1) "→" (sizeEnd: number: 0)
#\ row: "цвет" (colorStart: text: #FFFFFFFF) "→" (colorEnd: text: #00FFFFFF) "кривая" [curve: dropdown(линейно: linear, плавно: smooth, вход: ease_in, выход: ease_out, пульс: pulse)]
#\ template: {node}.particles.lifetime.sizeStart = {sizeStart}\n{node}.particles.lifetime.sizeEnd = {sizeEnd}\n{node}.particles.lifetime.colorStart = "{colorStart}"\n{node}.particles.lifetime.colorEnd = "{colorEnd}"\n{node}.particles.lifetime.sizeCurve = "{curve}"

