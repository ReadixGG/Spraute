#\ block: create_particle
#\ category: Частицы
#\ color: #f472b6
#\ shape: statement
#\
#\ row: "создать частицу" (id: text: my_particle)
#\ row: "текстура" (texture: text: textures/particle/my_particle.png)
#\ row: "в игре: spraute_engine:id"
#\
#\ code: var id = String(_getVal('id') || '').trim();
#\ code: function q(v) { return String(v || '').trim().replace(/\\/g, '\\\\').replace(/"/g, '\\"'); }
#\ code: var lines = ['create particle ' + id + ' {'];
#\ code: var tex = String(_getVal('texture') || '').trim();
#\ code: if (tex) lines.push('    texture = "' + q(tex) + '"');
#\ code: lines.push('}');
#\ code: return lines.join('\n') + '\n';

#\ block: particle_spawn
#\ category: Частицы
#\ color: #f472b6
#\ shape: statement
#\
#\ row: "частицы" [ptype: dropdown(огонь: flame, дым: smoke, души: soul, зачарование: enchant, сердце: heart, крит: crit, зелья: witch, портал: portal, облако: cloud, вспышка: flash, лава: lava, брызги: splash, свой id: custom)]
#\ if ptype == "custom":
#\   row: "id" (customType: text: spraute_engine:my_particle)
#\ row: "позиция" (x: number: 0) (y: number: 64) (z: number: 0)
#\ row: "кол-во" (count: number: 10)
#\ row: "разброс" (dx: number: 0) (dy: number: 0) (dz: number: 0) "скорость" (speed: number: 0.1)
#\
#\ if ptype != "custom":
#\   template: particleSpawn("{ptype}", {x}, {y}, {z}, {count}, {dx}, {dy}, {dz}, {speed})
#\ if ptype == "custom":
#\   template: particleSpawn("{customType}", {x}, {y}, {z}, {count}, {dx}, {dy}, {dz}, {speed})

