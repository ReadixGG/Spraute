#\ color: #d946ef
#\ shape: value
#\
#\ row: "ответы диалога" [count: dropdown(1: 1, 2: 2, 3: 3)]
#\ if count == "1":
#\   row: "1:" (a1: text: Да)
#\   template: list("{a1}")
#\ if count == "2":
#\   row: "1:" (a1: text: Да) "2:" (a2: text: Нет)
#\   template: list("{a1}", "{a2}")
#\ if count == "3":
#\   row: "1:" (a1: text: Да) "2:" (a2: text: Нет) "3:" (a3: text: Может)
#\   template: list("{a1}", "{a2}", "{a3}")

#\ block: dialog_classic
#\ category: Диалоги
