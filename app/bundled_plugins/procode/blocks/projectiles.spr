#\ block: spawn_projectile
#\ category: Снаряды
#\ color: #fb923c
#\ shape: statement
#\
#\ row: "снаряд" (projectileId: text: fireball)
#\ row: "позиция" (x: number: 0) (y: number: 64) (z: number: 0)
#\ row: "скорость" (vx: number: 0) (vy: number: 0) (vz: number: 1)
#\ row: "измерение" (dimension: text: ) "необязательно"
#\
#\ code: var id = String(_getVal('projectileId') || '').trim();
#\ code: var dim = String(_getVal('dimension') || '').trim();
#\ code: var args = [id, _getVal('x'), _getVal('y'), _getVal('z'), _getVal('vx'), _getVal('vy'), _getVal('vz')];
#\ code: if (dim) args.push('"' + dim.replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"');
#\ code: return 'spawnProjectile(' + args.join(', ') + ')\n';

#\ block: shoot_projectile
#\ category: Снаряды
#\ color: #fb923c
#\ shape: statement
#\
#\ row: "выстрелить" (projectileId: text: fireball)
#\ row: "из" [shooterMode: dropdown(игрок: player, НИП: npc, указать: custom)]
#\ if shooterMode == "player":
#\   row: "игрок" [playerMode: dropdown(первый: first, кликнувший: event, указать: custom)]
#\ if shooterMode == "player" and playerMode == "custom":
#\   input: shooter (type: value)
#\ if shooterMode == "npc":
#\   row: "НИП" [npc: dropdown_npc]
#\ if shooterMode == "custom":
#\   input: shooter (type: value)
#\ row: "скорость" (speed: number: 1.5)
#\ row: "смещение" (ox: number: 0) (oy: number: 0) (oz: number: 0)
#\ row: "измерение" (dimension: text: )
#\
#\ code: var shooter = '_eventPlayer';
#\ code: var sm = String(_getVal('shooterMode') || 'player');
#\ code: if (sm === 'player') {
#\ code:   var pm = String(_getVal('playerMode') || 'first');
#\ code:   if (pm === 'first') shooter = 'getFirstPlayer()';
#\ code:   else if (pm === 'custom') { var cv = String(_getVal('shooter') || '').trim(); if (cv) shooter = cv; }
#\ code: } else if (sm === 'npc') {
#\ code:   shooter = String(_getVal('npc') || '').trim();
#\ code: } else {
#\ code:   var cv = String(_getVal('shooter') || '').trim();
#\ code:   if (cv) shooter = cv;
#\ code: }
#\ code: var id = String(_getVal('projectileId') || '').trim();
#\ code: var speed = _getVal('speed');
#\ code: var ox = _getVal('ox'); var oy = _getVal('oy'); var oz = _getVal('oz');
#\ code: var dim = String(_getVal('dimension') || '').trim();
#\ code: var hasOffset = String(ox).trim() || String(oy).trim() || String(oz).trim();
#\ code: var fn = hasOffset ? 'shootProjectileNear' : 'shootProjectile';
#\ code: var args = [id, shooter, speed];
#\ code: if (hasOffset) { args.push(ox, oy, oz); }
#\ code: if (dim) args.push('"' + dim.replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"');
#\ code: return fn + '(' + args.join(', ') + ')\n';

