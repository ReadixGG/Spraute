#\ block: set_player_look
#\ category: Игрок
#\ color: #84cc16
#\ shape: statement
#\
#\ row: "взгляд игрока" [who: dropdown(кликнувший: event, первый: first, указать: custom)]
#\ if who == "custom":
#\   input: player (type: value)
#\ row: [mode: dropdown(углы: angles, на точку: coords, на цель: entity)]
#\ if mode == "angles":
#\   row: "yaw" (yaw: number: 0) "pitch" (pitch: number: 0)
#\ if mode == "coords":
#\   row: "точка" (x: number: 0) (y: number: 64) (z: number: 0)
#\ if mode == "entity":
#\   row: "цель" [target: dropdown(НИП: npc_ref, игрока: player, моба: mob)]
#\   if target == "npc_ref":
#\     row: [npc: dropdown_npc]
#\
#\ if mode == "angles" and who == "event":
#\   template: setPlayerLook(_eventPlayer, {yaw}, {pitch})
#\ if mode == "angles" and who == "first":
#\   template: setPlayerLook(getFirstPlayer(), {yaw}, {pitch})
#\ if mode == "angles" and who == "custom":
#\   template: setPlayerLook({player}, {yaw}, {pitch})
#\
#\ if mode == "coords" and who == "event":
#\   template: setPlayerLookAt(_eventPlayer, {x}, {y}, {z})
#\ if mode == "coords" and who == "first":
#\   template: setPlayerLookAt(getFirstPlayer(), {x}, {y}, {z})
#\ if mode == "coords" and who == "custom":
#\   template: setPlayerLookAt({player}, {x}, {y}, {z})
#\
#\ if mode == "entity" and target == "npc_ref" and who == "event":
#\   template: setPlayerLookAt(_eventPlayer, {npc})
#\ if mode == "entity" and target == "npc_ref" and who == "first":
#\   template: setPlayerLookAt(getFirstPlayer(), {npc})
#\ if mode == "entity" and target == "npc_ref" and who == "custom":
#\   template: setPlayerLookAt({player}, {npc})
#\ if mode == "entity" and target != "npc_ref" and who == "event":
#\   template: setPlayerLookAt(_eventPlayer, "{target}")
#\ if mode == "entity" and target != "npc_ref" and who == "first":
#\   template: setPlayerLookAt(getFirstPlayer(), "{target}")
#\ if mode == "entity" and target != "npc_ref" and who == "custom":
#\   template: setPlayerLookAt({player}, "{target}")

