#\ block: create_block
#\ category: Ресурсы
#\ color: #c084fc
#\ shape: statement
#\
#\ row: "создать блок" (id: text: my_block)
#\ row: "имя" (displayName: text: )
#\ row: [kind: dropdown(текстура: texture, 3D-модель: model, руда: ore)]
#\
#\ if kind == "texture":
#\   row: [texMode: dropdown(одна на все: single, верх и бока: top_sides, все грани: all)]
#\ if kind == "texture" and texMode == "single":
#\   row: "текстура" (texture: text: textures/block/my_block.png)
#\ if kind == "texture" and texMode == "top_sides":
#\   row: "верх" (textureUp: text: textures/block/my_block_top.png)
#\   row: "бока" (textureSides: text: textures/block/my_block_side.png)
#\   row: "запасная" (texture: text: ) "необязательно"
#\ if kind == "texture" and texMode == "all":
#\   row: "верх" (textureUp: text: textures/block/my_block_top.png)
#\   row: "низ" (textureDown: text: textures/block/my_block_bottom.png)
#\   row: "север" (textureNorth: text: textures/block/my_block_side.png)
#\   row: "юг" (textureSouth: text: textures/block/my_block_side.png)
#\   row: "запад" (textureWest: text: textures/block/my_block_side.png)
#\   row: "восток" (textureEast: text: textures/block/my_block_side.png)
#\ if kind == "texture":
#\   row: "прочность" (hardness: number: 1.5)
#\   row: "коллизия" [collision: dropdown(да: true, нет: false)]
#\
#\ if kind == "model":
#\   row: "модель" [model: dropdown_model]
#\   row: "текстура" [texture: dropdown_texture]
#\   row: "размер" (sizeW: number: 1) "×" (sizeD: number: 1) "×" (sizeH: number: 1)
#\   row: "поворот" [directional: dropdown(да: true, нет: false)]
#\   row: "прочность" (hardness: number: 1.5)
#\   row: "коллизия" [collision: dropdown(да: true, нет: false)]
#\   row: "хитбокс" (hitbox: text: )
#\
#\ if kind == "ore":
#\   row: [texMode: dropdown(одна на все: single, верх и бока: top_sides, все грани: all)]
#\ if kind == "ore" and texMode == "single":
#\   row: "текстура" (texture: text: textures/block/my_ore.png)
#\ if kind == "ore" and texMode == "top_sides":
#\   row: "верх" (textureUp: text: textures/block/my_ore_top.png)
#\   row: "бока" (textureSides: text: textures/block/my_ore_side.png)
#\ if kind == "ore" and texMode == "all":
#\   row: "верх" (textureUp: text: textures/block/my_ore_top.png)
#\   row: "низ" (textureDown: text: textures/block/my_ore_bottom.png)
#\   row: "север" (textureNorth: text: textures/block/my_ore_side.png)
#\   row: "юг" (textureSouth: text: textures/block/my_ore_side.png)
#\   row: "запад" (textureWest: text: textures/block/my_ore_side.png)
#\   row: "восток" (textureEast: text: textures/block/my_ore_side.png)
#\ if kind == "ore":
#\   row: "прочность" (hardness: number: 3.0)
#\   row: "жила" (oreVein: number: 8) "высота" (oreMin: number: -64) "–" (oreMax: number: 64)
#\   row: "попыток/чанк" (oreChances: number: 10)
#\   row: "измерение" [oreDim: dropdown(верхний мир: minecraft:overworld, ад: minecraft:the_nether, энд: minecraft:the_end)]
#\
#\ row: "свет 0–15" (light: text: )
#\ row: "дроп" (drop: text: )
#\ row: "кол-во дропа" (dropCount: number: 1)
#\ row: "вкладка креатива" (tab: text: )
#\
#\ code: var kind = _getVal('kind');
#\ code: var id = String(_getVal('id') || '').trim();
#\ code: var lines = ['create block ' + id + ' {'];
#\ code: function q(v) { return String(v || '').trim().replace(/\\/g, '\\\\').replace(/"/g, '\\"'); }
#\ code: function addStr(k, v) { v = String(v || '').trim(); if (v) lines.push('    ' + k + ' = "' + q(v) + '"'); }
#\ code: function addNum(k, v) { v = String(v || '').trim(); if (v) lines.push('    ' + k + ' = ' + v); }
#\ code: function addBool(k, v) { v = String(v || '').trim(); if (v === 'true' || v === 'false') lines.push('    ' + k + ' = ' + v); }
#\ code: function addBlockTex(texMode) {
#\ code:   if (texMode === 'top_sides') {
#\ code:     addStr('texture_up', _getVal('textureUp'));
#\ code:     addStr('texture_sides', _getVal('textureSides'));
#\ code:     addStr('texture', _getVal('texture'));
#\ code:   } else if (texMode === 'all') {
#\ code:     addStr('texture_up', _getVal('textureUp'));
#\ code:     addStr('texture_down', _getVal('textureDown'));
#\ code:     addStr('texture_north', _getVal('textureNorth'));
#\ code:     addStr('texture_south', _getVal('textureSouth'));
#\ code:     addStr('texture_west', _getVal('textureWest'));
#\ code:     addStr('texture_east', _getVal('textureEast'));
#\ code:   } else {
#\ code:     addStr('texture', _getVal('texture'));
#\ code:   }
#\ code: }
#\ code: if (kind === 'texture') {
#\ code:   var texMode = _getVal('texMode') || 'single';
#\ code:   addBlockTex(texMode);
#\ code:   addNum('hardness', _getVal('hardness'));
#\ code:   addBool('collision', _getVal('collision'));
#\ code: } else if (kind === 'model') {
#\ code:   addStr('model', _getVal('model'));
#\ code:   addStr('texture', _getVal('texture'));
#\ code:   lines.push('    size = [' + (_getVal('sizeW') || 1) + ', ' + (_getVal('sizeD') || 1) + ', ' + (_getVal('sizeH') || 1) + ']');
#\ code:   addBool('directional', _getVal('directional'));
#\ code:   addNum('hardness', _getVal('hardness'));
#\ code:   addBool('collision', _getVal('collision'));
#\ code:   var hb = String(_getVal('hitbox') || '').trim();
#\ code:   if (hb) lines.push('    hitbox = [' + hb + ']');
#\ code: } else if (kind === 'ore') {
#\ code:   var oreTexMode = _getVal('texMode') || 'single';
#\ code:   addBlockTex(oreTexMode);
#\ code:   addNum('hardness', _getVal('hardness'));
#\ code:   lines.push('    is_ore = true');
#\ code:   addNum('ore_vein', _getVal('oreVein'));
#\ code:   addNum('ore_min', _getVal('oreMin'));
#\ code:   addNum('ore_max', _getVal('oreMax'));
#\ code:   addNum('ore_chances', _getVal('oreChances'));
#\ code:   addStr('ore_dimension', _getVal('oreDim'));
#\ code: }
#\ code: var light = String(_getVal('light') || '').trim();
#\ code: if (light && light !== '0') lines.push('    light = ' + light);
#\ code: var drop = String(_getVal('drop') || '').trim();
#\ code: if (drop) {
#\ code:   addStr('drop', drop);
#\ code:   addNum('drop_count', _getVal('dropCount') || '1');
#\ code:   lines.push('    drop_replace = true');
#\ code: }
#\ code: addStr('name', _getVal('displayName'));
#\ code: addStr('tab', _getVal('tab'));
#\ code: lines.push('}');
#\ code: return lines.join('\n') + '\n';

#\ block: create_item
#\ category: Ресурсы
#\ color: #c084fc
#\ shape: statement
#\
#\ row: "создать предмет" (id: text: my_item)
#\ row: [itemKind: dropdown(плоская текстура: flat, 3D Bedrock: geo)]
#\
#\ if itemKind == "flat":
#\   row: "текстура" (texture: text: textures/item/my_item.png)
#\   row: "модель" (model: text: ) "необяз., напр. minecraft:item/wooden_sword"
#\ if itemKind == "geo":
#\   row: "geo-модель" [geo: dropdown_model]
#\   row: "текстура" [texture: dropdown_texture]
#\   row: "1 лицо" (handFirst: text: 0, 0, 0, 0, 0, 0, 0.55) "ox oy oz rx ry rz scale"
#\   row: "3 лицо" (handThird: text: 0, 0, 0, 0, 0, 0, 1)
#\   row: "на земле" (handGround: text: 0, 0, 0, 0, 0, 0, 1)
#\   row: "GUI / иконка" (guiTransform: text: 0, 0, 0, 25, 45, 0, 0.45)
#\
#\ row: "макс. стак" (maxStack: number: 64)
#\ row: "имя" (displayName: text: )
#\ row: "вкладка креатива" (tab: text: )
#\ row: "тип инструмента" (toolType: dropdown(нет: , меч: sword, кирка: pickaxe, топор: axe, лопата: shovel, мотыга: hoe))
#\ row: "урон" (damage: number: ) "бонус атаки, как у меча +5"
#\ row: "скорость атаки" (attackSpeed: number: ) "напр. -2.4"
#\ row: "прочность" (durability: number: 250)
#\ row: "скорость копания" (miningSpeed: number: 6) "для кирки/топора"
#\ row: "уровень добычи" (miningLevel: number: 2) "0=дерево, 2=железо"
#\
#\ code: var lines = ['create item ' + String(_getVal('id') || '').trim() + ' {'];
#\ code: function q(v) { return String(v || '').trim().replace(/\\/g, '\\\\').replace(/"/g, '\\"'); }
#\ code: function addStr(k, v) { v = String(v || '').trim(); if (v) lines.push('    ' + k + ' = "' + q(v) + '"'); }
#\ code: var kind = String(_getVal('itemKind') || 'flat').trim();
#\ code: if (kind === 'geo') {
#\ code:   addStr('geo', _getVal('geo'));
#\ code:   addStr('texture', _getVal('texture'));
#\ code:   function addTransform(k, field) { var v = String(_getVal(field) || '').trim(); if (v) lines.push('    ' + k + ' = [' + v + ']'); }
#\ code:   addTransform('hand_first', 'handFirst');
#\ code:   addTransform('hand_third', 'handThird');
#\ code:   addTransform('hand_ground', 'handGround');
#\ code:   addTransform('gui', 'guiTransform');
#\ code: } else {
#\ code:   addStr('texture', _getVal('texture'));
#\ code:   addStr('model', _getVal('model'));
#\ code: }
#\ code: var ms = String(_getVal('maxStack') || '').trim();
#\ code: if (ms) lines.push('    maxStackSize = ' + ms);
#\ code: addStr('name', _getVal('displayName'));
#\ code: addStr('tab', _getVal('tab'));
#\ code: addStr('tool_type', _getVal('toolType'));
#\ code: function addNum(k, v) { v = String(v || '').trim(); if (v) lines.push('    ' + k + ' = ' + v); }
#\ code: addNum('damage', _getVal('damage'));
#\ code: addNum('attack_speed', _getVal('attackSpeed'));
#\ code: addNum('durability', _getVal('durability'));
#\ code: addNum('mining_speed', _getVal('miningSpeed'));
#\ code: addNum('mining_level', _getVal('miningLevel'));
#\ code: lines.push('}');
#\ code: return lines.join('\n') + '\n';

