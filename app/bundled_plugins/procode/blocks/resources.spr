#\ block: create_craft
#\ category: Ресурсы
#\ color: #c084fc
#\ shape: statement
#\
#\ row: "крафт" (id: text: my_recipe)
#\ row: [mode: dropdown(сетка 3×3: grid, без формы: shapeless, печь: smelting, плавильня: blasting, коптильня: smoking, костёр: campfire_cooking)]
#\
#\ if mode == "grid":
#\   row: "1" (s1: text: ) "2" (s2: text: ) "3" (s3: text: )
