#\ row: "группа" (group: text) "payload" (payload: text)
#\ row: [constrain: dropdown(в родителе: true, свободно: false)] [revert: dropdown(вернуть если мимо: true, оставить: false)]
#\ row: "порог" (threshold: number: 4) "px"
#\ template: {node}.dragEnabled = {enabled}\n{node}.axis = "{axis}"\n{node}.group = "{group}"\n{node}.payload = "{payload}"\n{node}.constrain = {constrain}\n{node}.revert = {revert}\n{node}.threshold = {threshold}

