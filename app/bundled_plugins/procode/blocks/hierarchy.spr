#\ row: "нода" (node: value) [prop: dropdown(активна: active, замок: locked, превью: preview, имя: name, x: x, y: y, z: z, поворот_гориз: yaw, поворот_верт: pitch, roll: rotationZ, масштаб: scale, масштаб_x: scaleX, масштаб_y: scaleY, масштаб_z: scaleZ, хп: hp, скорость: speed, летит: flying, скорость_полёта: flyingSpeed, сглаживание_полёта: flySmoothing, плавание: swimming, коллизия: collision, неуязвим: invulnerable, беззвучный: silent, светится: glowing, прозрачная_текстура: translucent, прозрачность: opacity, авто_LOD: lod, дальность_рендера: renderDistance, приоритет_катсцены: forceVisible, прогружать_чанки: loadChunks, без_гравитации: noGravity, имя_видно: showName, модель: model, текстура: texture, анимация: animation, idle: idleAnim, walk: walkAnim, группа: group, скрипт: script, запуск_со_сценой: runOnSceneStart, ширина: width, высота: height, глубина: depth, твердый: solid, триггер: trigger, id_триггера: triggerId, смещение_x: offsetX, смещение_y: offsetY, смещение_z: offsetZ, свет: light, включен: enabled, показать_свет: showLight, звук: audioSound, громкость: audioVolume, питч: audioPitch, цикл_звука: audioLoop, тип_частиц: particleType, число_частиц: particleCount, скорость_частиц: particleSpeed, гравитация: particleGravity, цикл_частиц: particleLoop, коллизия_частиц: particleCollide, ширина_билборда: billboardWidth, высота_билборда: billboardHeight, насквозь: seeThrough, текст_ui: uiText, цвет_ui: uiColor, альфа: uiAlpha, ширина_ui: uiW, высота_ui: uiH, слой: canvasLayer, оверлей: canvasOverlay, автопоказ: canvasAutoShow, можно_закрыть: canvasCanClose, кроп: src, кроп_u: srcU, кроп_v: srcV, кроп_w: srcW, кроп_h: srcH, форма_кропа: cropShape, размытие_кропа: feather, заполнение: fill, доля_заполнения: fillAmount, начало_заполнения: fillOrigin)] "="
