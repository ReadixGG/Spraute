#\ row: "справа" (right: number: 1) "снизу" (bottom: number: 1)
#\ template: {node}.feather = {radius}\n{node}.featherSmooth = {curve}\n{node}.featherL = {left}\n{node}.featherT = {top}\n{node}.featherR = {right}\n{node}.featherB = {bottom}

