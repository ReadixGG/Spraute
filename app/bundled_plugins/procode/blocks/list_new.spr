#\ code: return (function(){ var p=[], vs=["item1","item2","item3","item4","item5","item6","item7","item8"]; for(var i=0;i<8;i++){ var v=_getVal(vs[i]).trim(); if(v) p.push(v); } return p.length?"list("+p.join(", ")+")":"list()"; })();
