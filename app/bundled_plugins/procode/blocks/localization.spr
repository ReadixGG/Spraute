#\ block: tr
#\ category: Локализация
#\ color: #38bdf8
#\ shape: value
#\
#\ row: "перевод" (key: text: welcome)
#\ row: "игрок" input: player (type: value)
#\ row: "аргумент" input: arg (type: value)
#\ code: return (function(){ var parts=[_str("key")]; var p=_getVal("player").trim(); var a=_getVal("arg").trim(); if(p) parts.push(p); if(a) parts.push(a); return "tr("+parts.join(", ")+")"; })();

#\ block: t_ru_en
#\ category: Локализация
#\ color: #38bdf8
#\ shape: value
#\
#\ row: "по-русски" (ru: text: Привет)
#\ row: "по-английски" (en: text: Hello)
#\ row: "игрок" input: player (type: value)
#\ code: return (function(){ var p=_getVal("player").trim(); var s="t("+_str("ru")+", "+_str("en"); return p?s+", "+p+")":s+")"; })();

#\ block: translate_map
