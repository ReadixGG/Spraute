#\ block: npc_moveto
#\ category: НПС
#\ color: #0ea5e9
#\ shape: statement
#\
#\ row: "НИП" [npc: dropdown_npc] [mode: dropdown(идти к: moveTo, ждать прихода: moveToAwait, всегда идти к: alwaysMoveTo, остановить: stopMove)]
#\ if mode == "moveTo" or mode == "moveToAwait" or mode == "alwaysMoveTo":
#\   row: "X" (x: number: 0) "Y" (y: number: 64) "Z" (z: number: 0) "скорость" (speed: number: 1)
#\   row: "поворачивать к движению" [faceWalk: checkbox(true)]
#\ if mode == "stopMove":
#\   template: {npc}.stopMove()
#\ if mode == "moveTo":
#\   template: {npc}.moveTo({x}, {y}, {z}, {speed}, {faceWalk})
#\ if mode == "moveToAwait":
#\   template: await {npc}.moveTo({x}, {y}, {z}, {speed}, {faceWalk})
#\ if mode == "alwaysMoveTo":
#\   template: {npc}.alwaysMoveTo({x}, {y}, {z}, {speed}, {faceWalk})
