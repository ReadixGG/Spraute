#\ row: "у игрока ("
#\ input: player (type: value)
#\ row: ") свойство" [prop: dropdown(имя: name, здоровье: hp, макс. HP: maxHp, голод: hunger, насыщение: saturation, воздух: air, макс. воздух: maxAir, слот хотбара: selectedSlot, броня: armor, поглощение: absorption, уровень: xpLevel, опыт: xpTotal, X: x, Y: y, Z: z, поворот: yaw, наклон: pitch, UUID: uuid, взгляд X: lookX, взгляд Y: lookY, взгляд Z: lookZ, крадётся: sneaking, бежит: sprinting, на земле: onGround, режим: gamemode, пинг: ping, полёт разрешён: flightEnabled, летит: flying, скорость полёта: flySpeed, скорость ходьбы: walkSpeed, скорость движения: movementSpeed, сила прыжка: jumpStrength, высота шага: stepHeight, урон атаки: attackDamage, множитель копания: digSpeed, дальность блоков: blockReach, неуязвим: invulnerable, бесконечное строительство: instabuild, урон включён: healthEnabled, голод включён: hungerEnabled, полоска опыта: xpVisible, запрет F5: lockPerspective, язык: language, короткий язык: lang, английский?: isEnglish)]
#\ template: {player}.{prop}

#\ block: player_set_prop
#\ category: Игрок
#\ color: #84cc16
