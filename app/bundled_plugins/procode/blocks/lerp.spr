#\ block: lerp_to
#\ category: Математика
#\ color: #ef4444
#\ shape: statement
#\
#\ row: "lerp к" input: target (type: value)
#\ row: "свойство" (prop: text: x) "=" input: end (type: value)
#\ row: "за" (time: number: 1) "сек" [easing: dropdown(линейно: linear, плавно: easeInOut, в конце: easeOut, в начале: easeIn, отскок: bounceOut, пружина: elasticOut)]
#\ row: [runMode: dropdown(запустить: play, ждать конца: await)]
#\
#\ if runMode == "play":
#\   template: lerpTo({target}, "{prop}", {end}, {time}, "{easing}")
#\ if runMode == "await":
#\   template: await time(lerpTo({target}, "{prop}", {end}, {time}, "{easing}"))

