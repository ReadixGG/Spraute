#\ block: aoe_damage_players
#\ category: Игрок
#\ color: #22c55e
#\ shape: statement
#\
#\ row: "урон" (damage: number: 2) "игрокам в радиусе" (radius: number: 4) "от"
#\ row: [anchor: dropdown(НИП: npc, из события — сущность: event_entity, указать: custom)]
#\ if anchor == "npc":
#\   row: [npc: dropdown_npc]
#\ if anchor == "custom":
#\   input: center (type: value)
#\
#\ if anchor == "npc":
#\   template: val __aoe_pl = playersNear({npc}, {radius})\nvar __aoe_i = 0\nwhile (__aoe_i < listSize(__aoe_pl)) {\n  val __aoe_p = listGet(__aoe_pl, __aoe_i)\n  __aoe_p.damage({damage})\n  __aoe_i = __aoe_i + 1\n}
#\ if anchor == "event_entity":
#\   template: val __aoe_pl = playersNear(_eventEntity, {radius})\nvar __aoe_i = 0\nwhile (__aoe_i < listSize(__aoe_pl)) {\n  val __aoe_p = listGet(__aoe_pl, __aoe_i)\n  __aoe_p.damage({damage})\n  __aoe_i = __aoe_i + 1\n}
#\ if anchor == "custom":
#\   template: val __aoe_pl = playersNear({center}, {radius})\nvar __aoe_i = 0\nwhile (__aoe_i < listSize(__aoe_pl)) {\n  val __aoe_p = listGet(__aoe_pl, __aoe_i)\n  __aoe_p.damage({damage})\n  __aoe_i = __aoe_i + 1\n}
