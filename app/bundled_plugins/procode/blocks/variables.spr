#\ block: var_declare
#\ category: Переменные
#\ color: #94a3b8
#\ shape: statement
#\
#\ row: [scope: dropdown(локальная: local, глобальная скрипта: global, мира — сохраняется: world)]
#\ row: [kind: dropdown(неизменяемая (val): val, изменяемая (var): var)]
#\ row: "имя" (name: text: my_var)
#\ input: init (type: value) "= значение"
#\
#\ if scope == "local" and kind == "val":
#\   template: val {name} = {init}
#\ if scope == "local" and kind == "var":
#\   template: var {name} = {init}
#\ if scope == "global" and kind == "val":
#\   template: global val {name} = {init}
#\ if scope == "global" and kind == "var":
#\   template: global var {name} = {init}
#\ if scope == "world" and kind == "val":
#\   template: world val {name} = {init}
#\ if scope == "world" and kind == "var":
#\   template: world var {name} = {init}

#\ block: var_set
