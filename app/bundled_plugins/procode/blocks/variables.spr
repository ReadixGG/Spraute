#\ row: "переменная" (name: text: my_var)
#\ template: {name}

#\ block: incr
#\ category: Переменные
#\ color: #94a3b8
#\ shape: statement
#\
#\ row: "увеличить" (name: text: count)
#\ row: [mode: dropdown(на 1: one, на: custom)]
#\ if mode == "custom":
#\   input: amount (type: value)
#\
#\ if mode == "one":
#\   template: {name} = {name} + 1
#\ if mode == "custom":
#\   template: {name} = {name} + {amount}

