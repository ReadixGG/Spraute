#\ block: npc_follow_route
#\ category: Маршруты
#\ color: #06b6d4
#\ shape: statement
#\
#\ row: "НИП" [npc: dropdown_npc] [mode: dropdown(идти по точкам: walk, лететь по кривой: fly)]
#\ row: [repeat: dropdown(один раз: once, всегда: always)] "путь" input: route (type: value)
#\ row: "скорость" (speed: number: 1)
#\ if repeat == "once":
#\   row: "ждать окончания" [waitDone: checkbox(false)]
#\ if mode == "walk" and repeat == "once" and waitDone:
#\   template: await {npc}.followRoute({route}, {speed})
#\ if mode == "walk" and repeat == "once" and not waitDone:
#\   template: {npc}.followRoute({route}, {speed})
#\ if mode == "walk" and repeat == "always":
#\   template: {npc}.alwaysFollowRoute({route}, {speed})
#\ if mode == "fly" and repeat == "once" and waitDone:
#\   template: await {npc}.flyRoute({route}, {speed})
#\ if mode == "fly" and repeat == "once" and not waitDone:
#\   template: {npc}.flyRoute({route}, {speed})
#\ if mode == "fly" and repeat == "always":
#\   template: {npc}.alwaysFlyRoute({route}, {speed})

