#\ block: fade_in
#\ category: Камера
#\ color: #8b5cf6
#\ shape: statement
#\
#\ row: "затемнение" input: player (type: value)
#\ row: "за" (time: number: 1.0) "сек"
#\ row: "текст" (text: textmultiline: )
#\ row: "подзаголовок" (subtitle: textmultiline: )
#\ row: "цвет" (color: color: 0x000000)
#\ row: "держать" (visibleTime: number: 2.0) "сек"
#\ row: "само осветление" [fadeout: checkbox]
#\ if fadeout:
#\   row: "осветление за" (timeOut: number: 1.0) "сек"
#\ row: "скрыть другой GUI" [hide_gui: checkbox]
#\
#\ template: fadeIn {\n  target = {player}\n  time = {time}\n  visibleTime = {visibleTime}\n  timeOut = {timeOut}\n  color = {color}\n  text = "{text}"\n  subtitle = "{subtitle}"\n  fadeout = {fadeout}\n  hide_gui = {hide_gui}\n}\n

